// A REJECTED RULE. This is the pairing of a φ-node with a load that
// judges the load whole, over every store that reaches it. Its
// counterexample is the reason pairStep reads the load along each edge.
//
//   var u *T
//   var err error
//   defer func() { log(err) }()
//   if b { u = x } else { err = e }
//   return u, err               reported: "F returns a nil *T with a nil error"
//
// u is nil on the else edge. The zero of err reaches the load through the
// then edge. No run returns nil with a nil error.
//
// The program, the run and the claim are those of pairing_load.fsl, except
// for reported and the witness. The witness takes the edge whose stores
// make err nil. The run is limited to programs that pairing_load.fsl's rule
// does not report.
fsl 5
spec PairingLoadWhole {
  // NonNilLiteral is &T{}, and Outside is f(). NoErrorStore: the arm
  // stores nothing into err.
  enum PointerOperand { Nil, NonNilLiteral, Outside }
  enum ErrorStore { NoErrorStore, ErrorBad, ErrorGood, ErrorOutside }
  enum Phase { Ready, PastEarlierIf, PastSwitch, Returned }
  type Edge = 0..2
  type EarlierEdge = 0..1
  type ChoiceBit = 0..18

  state {
    phase: Phase,
    choice: Map<ChoiceBit, Bool>,
    // the program
    earlierStore: Map<EarlierEdge, ErrorStore>,
    armPointer: Map<Edge, PointerOperand>,
    armError: Map<Edge, ErrorStore>,
    hasLaterIf: Bool,
    laterStore: ErrorStore,
    // the verdict and its witness
    verdict: Bool,
    witnessEdge: Edge,
    witnessEarlierEdge: EarlierEdge,
    witnessLaterTaken: Bool,
    // the run's own record
    errIsBadBeforeSwitch: Bool,
    pointerIsNil: Bool,
    pointerIsOutsideNil: Bool,
    errorIsBad: Bool,
    onWitness: Bool,
    // the path the run took
    takenEarlierEdge: EarlierEdge,
    takenEdge: Edge,
    laterTaken: Bool
  }

  def pickPointer(bit: ChoiceBit) =
    if choice[bit] then Nil
    else if choice[bit + 1] then NonNilLiteral
    else Outside
  def pickErrorStore(bit: ChoiceBit) =
    if choice[bit] then
      if choice[bit + 1] then NoErrorStore
      else ErrorBad
    else
      if choice[bit + 1] then ErrorGood
      else ErrorOutside

  // --- the rule -------------------------------------------------------------------

  // The Alloc's zero is the nil error.
  def storeIsBad(store: ErrorStore) = store == ErrorBad or store == NoErrorStore
  // Some store that reaches the end of the arm on this edge stores Bad.
  def badStoreReachesArmEnd(edge: Edge) =
    if armError[edge] != NoErrorStore then armError[edge] == ErrorBad
    else exists earlierEdge: EarlierEdge { storeIsBad(earlierStore[earlierEdge]) }
  // Some store that reaches the load through this edge stores Bad: L, or
  // a store that reaches the end of the arm.
  def badStoreReachesLoad(edge: Edge) =
    (hasLaterIf and laterStore == ErrorBad)
    or badStoreReachesArmEnd(edge)
  // THE NAIVE RULE: the load is judged whole. Some edge brings nil for u,
  // and some edge, maybe another, brings a Bad store to the load.
  def reported() =
    (exists edge: Edge { armPointer[edge] == Nil })
    and (exists edge: Edge { badStoreReachesLoad(edge) })
  // The rule of pairing_load.fsl, to pick the programs it does not report.
  def provedReported() =
    exists edge: Edge {
      armPointer[edge] == Nil
      and badStoreReachesLoad(edge)
    }

  // The witness: the first edge that brings a Bad store to the load.
  def firstEdge() =
    if badStoreReachesLoad(0) then 0
    else if badStoreReachesLoad(1) then 1
    else 2
  def firstEarlierEdge() = if storeIsBad(earlierStore[0]) then 0 else 1
  def laterStoresBad() = hasLaterIf and laterStore == ErrorBad

  init {
    phase = Ready
    forall earlierEdge: EarlierEdge {
      earlierStore[earlierEdge] = pickErrorStore(2 * earlierEdge)
    }
    forall edge: Edge {
      armPointer[edge] = pickPointer(4 + 4 * edge)
      armError[edge] = pickErrorStore(6 + 4 * edge)
    }
    hasLaterIf = choice[16]
    laterStore = pickErrorStore(17)
    verdict = reported()
    witnessEdge = firstEdge()
    witnessEarlierEdge = firstEarlierEdge()
    witnessLaterTaken = laterStoresBad()
    errIsBadBeforeSwitch = true
    pointerIsNil = false
    pointerIsOutsideNil = false
    errorIsBad = false
    onWitness = false
    takenEarlierEdge = 0
    takenEdge = 0
    laterTaken = false
  }

  // --- the run --------------------------------------------------------------------

  action earlierIf(earlierEdge: EarlierEdge) {
    requires phase == Ready
    requires not provedReported()
    phase = PastEarlierIf
    takenEarlierEdge = earlierEdge
    errIsBadBeforeSwitch =
      if earlierStore[earlierEdge] == NoErrorStore then errIsBadBeforeSwitch
      else earlierStore[earlierEdge] == ErrorBad
    onWitness = verdict and earlierEdge == witnessEarlierEdge
  }

  action takeArm(edge: Edge, outsideNil: Bool) {
    requires phase == PastEarlierIf
    phase = PastSwitch
    takenEdge = edge
    pointerIsNil = armPointer[edge] == Nil
    pointerIsOutsideNil = armPointer[edge] == Outside and outsideNil
    errorIsBad =
      if armError[edge] == NoErrorStore then errIsBadBeforeSwitch
      else armError[edge] == ErrorBad
    onWitness = onWitness and edge == witnessEdge and not outsideNil
  }

  // The later if, taken or not, then the return.
  action laterIf(later: Bool) {
    requires phase == PastSwitch
    requires hasLaterIf or not later
    phase = Returned
    laterTaken = later
    errorIsBad =
      if later and laterStore != NoErrorStore then laterStore == ErrorBad
      else errorIsBad
    onWitness = onWitness and later == witnessLaterTaken
  }

  terminal { phase == Returned }

  // --- what holds, and the claim that breaks --------------------------------------

  // The negation of ReportMeansNilWithBad in pairing_load.fsl. The witness
  // run does not return nil with Bad, so this rule reports a pair no run gives.
  reachable ReportedPairIsNotReturned {
    not ((onWitness and phase == Returned) => (pointerIsNil and errorIsBad))
  }
  invariant NilWithBadIsReported {
    (phase == Returned and pointerIsNil and errorIsBad) => reported()
  }

  // The auxiliary invariants of the proved spec are left out. So verify.sh
  // checks this spec by BMC to a depth, not by induction.

  // --- witnesses ------------------------------------------------------------------

  // The earlier if stores the nil error on one arm and a non-nil one on the
  // other. So the load has two alternatives on the edge that keeps err.
  reachable EarlierStoreReported {
    phase == Returned
    and reported()
    and onWitness
    and armError[witnessEdge] == NoErrorStore
    and earlierStore[witnessEarlierEdge] == ErrorBad
    and earlierStore[1 - witnessEarlierEdge] == ErrorGood
  }
  reachable ZeroThroughBoth {
    phase == Returned
    and reported()
    and onWitness
    and armError[witnessEdge] == NoErrorStore
    and earlierStore[witnessEarlierEdge] == NoErrorStore
  }
}
