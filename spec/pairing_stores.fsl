// Pairing along stores: return-nil for a bare return that loads its
// results. See "return-nil" in design/rules.md.
//
// A function with a defer stores its results into local variables, runs
// its defers, then loads them. A bare return stores nothing, so both loads
// follow the stores that reach them. The pointer and the error are paired
// along each path back to those stores, so both results are read on the
// same path. The two stored values are then paired again, since they may be
// φ-nodes of one earlier block. internal/flow/pair.go does this, with
// pairStores and then pair.
//
// The program:
//
//   func F() (u *T, err error) {  each Alloc is a store of the zero value
//     defer mu.Unlock()
//     if b { x, e = PX0, PY0 } else { x, e = PX1, PY1 }   an earlier join P
//     u = U0                      either store may be left out
//     err = E0
//     for ... {                   the loop is there or not (looped)
//       if c {                    two arms. Each may store into u, into
//         u, err = ...            err, into both, or into neither
//       } else { ... }
//     }
//     [e := err]                  the error may be loaded here
//                                 (errorLoadedEarly)
//     u = AU                      stores between the loop and the return.
//     err = AE                    Either may be left out, or store x or e
//     return                      loads u, and err unless loaded above
//   }
//
// In the state, PX and PY are earlierX and earlierE. U0 and E0 are
// entryPointer and entryError. The arms' stores are armPointer and
// armError. AU and AE are afterPointer and afterError.
//
// The stores into u are nil, &T{} or f(). The stores into err are Bad (the
// nil constant), Good (errors.New) or Out (f()). With a trailing bool in
// place of the error, Bad is `true` and Good is `false`. The Alloc's zero
// is then Good rather than Bad (trailingBool).
//
// This program has the shape, and it is not reported. The stored values
// are φ-nodes of P, paired along P's edges:
//
//   if b { x, e = nil, errX } else { x, e = get(), nil }
//   u, err = x, e
//   return
//
// With errorLoadedEarly, the function returns u and e, so the error is the
// one loaded before the store after the loop. Each load reads the last
// store before itself on the path. So AE does not reach the error, and AU
// still reaches the pointer.
//
// The rule, reported below, needs some path back from the return. On it,
// the last store of u before its load is a nil constant or the zero. The
// last store of err before its load is a Bad constant. When both stored values come from P, they are read
// along one edge of P. Without the loop, a path goes through one arm. With
// it, a path goes through any number, and the last stores of u and err may
// come from different rounds. Two rounds are enough to reach any such pair:
// the round of one result's last store, then the other's.
//
// The run keeps its own record of each result. It notes whether u holds
// the nil constant (pointerIsNil) or a nil from outside
// (pointerIsOutsideNil). It notes whether err holds the Bad constant
// (errorIsBad). The rule never reads them.
//
// The claim:
//
//   WitnessNeverBlocked     each round and the exit that the witness takes
//                           are enabled
//   ReportMeansNilWithBad   when reported, the witness run returns the nil
//                           constant with a Bad constant
//   NilWithBadIsReported    whenever a run returns them, it is reported
//
// ASSUME-1: branches and the loop are taken as independent, as the rule
//   defines. The gap when they correlate is nil_value_correlated.fsl.
// ASSUME-2: nothing but loads and stores uses u or err. An escaped result
//   is not followed, and local_store.fsl covers that. A literal that only
//   loads them keeps them followed.
// ASSUME-3 (representation only): the stores are constants, values from
//   outside, or x and e. Nil checks on the way are the subject of
//   nil_value.fsl and pairing.fsl. On a loaded variable they are a gap
//   (local_store.fsl ASSUME-3).
fsl 5
spec PairingStores {
  // NoPointerStore and NoErrorStore: no store of that result. At the entry
  // they stand for the Alloc's zero. PointerFromX and ErrorFromE store x
  // and e, the φ-nodes of P.
  enum PointerStore { NoPointerStore, PointerNil, PointerNonNil, PointerOutside, PointerFromX }
  enum ErrorStore { NoErrorStore, ErrorBad, ErrorGood, ErrorOutside, ErrorFromE }
  enum Phase { Ready, Joined, InLoop, LeftLoop, Returned }
  // An arm, or 2 for no arm: the entry's store, or no round at all.
  type ArmOrNone = 0..2
  type Arm = 0..1
  type EarlierEdge = 0..1
  type Rounds = 0..2
  type ChoiceBit = 0..28

  state {
    phase: Phase,
    choice: Map<ChoiceBit, Bool>,
    // the program
    earlierX: Map<EarlierEdge, PointerStore>,
    earlierE: Map<EarlierEdge, ErrorStore>,
    entryPointer: PointerStore,
    entryError: ErrorStore,
    armPointer: Map<Arm, PointerStore>,
    armError: Map<Arm, ErrorStore>,
    afterPointer: PointerStore,
    afterError: ErrorStore,
    looped: Bool,
    trailingBool: Bool,
    errorLoadedEarly: Bool,
    // the verdict and its witness path
    verdict: Bool,
    witnessFirstArm: ArmOrNone,
    witnessLaterArm: ArmOrNone,
    witnessEarlierEdge: EarlierEdge,
    // the run: which arm's store each result holds, and which came last
    pointerArm: ArmOrNone,
    errorArm: ArmOrNone,
    pointerStoredLater: Bool,
    lastArm: ArmOrNone,
    rounds: Rounds,
    earlierEdgeTaken: EarlierEdge,
    // the run's own record of the values
    xIsNil: Bool,
    xIsOutsideNil: Bool,
    eIsBad: Bool,
    pointerIsNil: Bool,
    pointerIsOutsideNil: Bool,
    errorIsBad: Bool,
    onWitness: Bool
  }

  def pickPointerStore(bit: ChoiceBit) =
    if choice[bit] then
      if choice[bit + 1] then NoPointerStore
      else PointerNil
    else
      if choice[bit + 1] then PointerNonNil
      else PointerOutside
  def pickErrorStore(bit: ChoiceBit) =
    if choice[bit] then
      if choice[bit + 1] then NoErrorStore
      else ErrorBad
    else
      if choice[bit + 1] then ErrorGood
      else ErrorOutside
  def pickEarlierPointer(bit: ChoiceBit) =
    if choice[bit] then PointerNil
    else if choice[bit + 1] then PointerNonNil
    else PointerOutside
  def pickEarlierError(bit: ChoiceBit) =
    if choice[bit] then ErrorBad
    else if choice[bit + 1] then ErrorGood
    else ErrorOutside
  def pickAfterPointer(bit: ChoiceBit) =
    if choice[bit] then pickPointerStore(bit + 1) else PointerFromX
  def pickAfterError(bit: ChoiceBit) =
    if choice[bit] then pickErrorStore(bit + 1) else ErrorFromE

  // --- the rule -------------------------------------------------------------------

  // What a store gives. At the entry, NoPointerStore and NoErrorStore stand
  // for the Alloc's zero.
  def pointerStoreIsNil(store: PointerStore) = store == NoPointerStore or store == PointerNil
  def errorStoreIsBad(store: ErrorStore) =
    store == ErrorBad or (store == NoErrorStore and not trailingBool)
  // The last store of each result on the path: the arm first, then the arm
  // later, then the store after the loop. The values x and e from P are
  // read along P's edge.
  def loopPointerStore(first: ArmOrNone, later: ArmOrNone) =
    if later != 2 and armPointer[later] != NoPointerStore then armPointer[later]
    else if first != 2 and armPointer[first] != NoPointerStore then armPointer[first]
    else entryPointer
  def loopErrorStore(first: ArmOrNone, later: ArmOrNone) =
    if later != 2 and armError[later] != NoErrorStore then armError[later]
    else if first != 2 and armError[first] != NoErrorStore then armError[first]
    else entryError
  def lastPointerStore(first: ArmOrNone, later: ArmOrNone, edge: EarlierEdge) =
    if afterPointer == PointerFromX then earlierX[edge]
    else if afterPointer != NoPointerStore then afterPointer
    else loopPointerStore(first, later)
  // An error loaded early does not see the store after the loop.
  def lastErrorStore(first: ArmOrNone, later: ArmOrNone, edge: EarlierEdge) =
    if errorLoadedEarly then loopErrorStore(first, later)
    else if afterError == ErrorFromE then earlierE[edge]
    else if afterError != NoErrorStore then afterError
    else loopErrorStore(first, later)
  def isPath(first: ArmOrNone, later: ArmOrNone) =
    if looped then (first == 2 => later == 2) else (first != 2 and later == 2)
  def pairs(first: ArmOrNone, later: ArmOrNone, edge: EarlierEdge) =
    isPath(first, later)
    and pointerStoreIsNil(lastPointerStore(first, later, edge))
    and errorStoreIsBad(lastErrorStore(first, later, edge))
  def pairsOnPath(first: ArmOrNone, later: ArmOrNone) =
    exists edge: EarlierEdge { pairs(first, later, edge) }
  def reported() = exists first: ArmOrNone { exists later: ArmOrNone { pairsOnPath(first, later) } }

  def firstArmOfPath() =
    if exists later: ArmOrNone { pairsOnPath(0, later) } then 0
    else if exists later: ArmOrNone { pairsOnPath(1, later) } then 1
    else 2
  def laterArmOfPath(first: ArmOrNone) =
    if pairsOnPath(first, 0) then 0
    else if pairsOnPath(first, 1) then 1
    else 2
  def earlierEdgeOfPath(first: ArmOrNone, later: ArmOrNone) = if pairs(first, later, 0) then 0 else 1
  def pathLength(first: ArmOrNone, later: ArmOrNone) =
    (if first != 2 then 1 else 0) + (if later != 2 then 1 else 0)

  init {
    phase = Ready
    forall edge: EarlierEdge {
      earlierX[edge] = pickEarlierPointer(4 * edge)
      earlierE[edge] = pickEarlierError(4 * edge + 2)
    }
    entryPointer = pickPointerStore(8)
    entryError = pickErrorStore(10)
    forall arm: Arm {
      armPointer[arm] = pickPointerStore(12 + 4 * arm)
      armError[arm] = pickErrorStore(14 + 4 * arm)
    }
    afterPointer = pickAfterPointer(20)
    afterError = pickAfterError(23)
    looped = choice[26]
    trailingBool = choice[27]
    errorLoadedEarly = choice[28]
    // The verdict and the witness read only the program set above.
    verdict = reported()
    witnessFirstArm = firstArmOfPath()
    witnessLaterArm = laterArmOfPath(firstArmOfPath())
    witnessEarlierEdge = earlierEdgeOfPath(firstArmOfPath(), laterArmOfPath(firstArmOfPath()))
    pointerArm = 2
    errorArm = 2
    pointerStoredLater = false
    lastArm = 2
    rounds = 0
    earlierEdgeTaken = 0
    xIsNil = false
    xIsOutsideNil = false
    eIsBad = false
    pointerIsNil = true
    pointerIsOutsideNil = false
    errorIsBad = not trailingBool
    onWitness = false
  }

  // --- the run --------------------------------------------------------------------

  // The run's own reading of a store: the nil constant, a nil from outside,
  // or Bad.
  def recordNil(store: PointerStore, previous: Bool) =
    if store == NoPointerStore then previous else store == PointerNil
  def recordOutsideNil(store: PointerStore, outsideNil: Bool, previous: Bool) =
    if store == NoPointerStore then previous else (store == PointerOutside and outsideNil)
  def recordBad(store: ErrorStore, previous: Bool) =
    if store == NoErrorStore then previous else store == ErrorBad

  action passEarlierIf(edge: EarlierEdge, outsideNil: Bool) {
    requires phase == Ready
    phase = Joined
    earlierEdgeTaken = edge
    xIsNil = earlierX[edge] == PointerNil
    xIsOutsideNil = earlierX[edge] == PointerOutside and outsideNil
    eIsBad = earlierE[edge] == ErrorBad
    onWitness = verdict and edge == witnessEarlierEdge and not outsideNil
  }

  action enter(outsideNil: Bool) {
    requires phase == Joined
    phase = InLoop
    pointerIsNil = recordNil(entryPointer, pointerIsNil)
    pointerIsOutsideNil = recordOutsideNil(entryPointer, outsideNil, pointerIsOutsideNil)
    errorIsBad = recordBad(entryError, errorIsBad)
    onWitness = onWitness and not outsideNil
  }

  action round(arm: Arm, outsideNil: Bool) {
    requires phase == InLoop
    requires looped or rounds == 0
    pointerIsNil = recordNil(armPointer[arm], pointerIsNil)
    pointerIsOutsideNil = recordOutsideNil(armPointer[arm], outsideNil, pointerIsOutsideNil)
    errorIsBad = recordBad(armError[arm], errorIsBad)
    pointerArm = if armPointer[arm] != NoPointerStore then arm else pointerArm
    errorArm = if armError[arm] != NoErrorStore then arm else errorArm
    pointerStoredLater =
      if armPointer[arm] != NoPointerStore and armError[arm] == NoErrorStore then true
      else if armError[arm] != NoErrorStore then false
      else pointerStoredLater
    lastArm = arm
    rounds = min(rounds + 1, 2)
    onWitness = onWitness
                and rounds < pathLength(witnessFirstArm, witnessLaterArm)
                and (if rounds == 0 then arm == witnessFirstArm else arm == witnessLaterArm)
                and not outsideNil
  }

  action leave() {
    requires phase == InLoop
    requires looped or rounds == 1
    phase = LeftLoop
    onWitness = onWitness and rounds == pathLength(witnessFirstArm, witnessLaterArm)
  }

  // The store after the loop, then the return's loads. An error loaded
  // early keeps what it held before that store.
  action bareReturn(outsideNil: Bool) {
    requires phase == LeftLoop
    phase = Returned
    pointerIsNil =
      if afterPointer == PointerFromX then xIsNil
      else recordNil(afterPointer, pointerIsNil)
    pointerIsOutsideNil =
      if afterPointer == PointerFromX then xIsOutsideNil
      else recordOutsideNil(afterPointer, outsideNil, pointerIsOutsideNil)
    errorIsBad =
      if errorLoadedEarly then errorIsBad
      else if afterError == ErrorFromE then eIsBad
      else recordBad(afterError, errorIsBad)
    onWitness = onWitness and not outsideNil
  }

  terminal { phase == Returned }

  // --- what is proved -------------------------------------------------------------

  // Never blocked: each round and the exit that the witness takes are
  // enabled.
  invariant WitnessNeverBlocked {
    (onWitness and phase == InLoop) => (
      (rounds < pathLength(witnessFirstArm, witnessLaterArm) => (looped or rounds == 0))
      and (rounds == pathLength(witnessFirstArm, witnessLaterArm) => (looped or rounds == 1))
    )
  }
  invariant ReportMeansNilWithBad {
    (onWitness and phase == Returned) => (pointerIsNil and errorIsBad)
  }
  invariant NilWithBadIsReported {
    (phase == Returned and pointerIsNil and errorIsBad) => reported()
  }

  // --- auxiliary ------------------------------------------------------------------

  def heldPointerStore() = if pointerArm == 2 then entryPointer else armPointer[pointerArm]
  def heldErrorStore() = if errorArm == 2 then entryError else armError[errorArm]
  // The path of at most two arms that gives what the run holds: the arm of
  // the earlier last store, then the later one.
  def heldFirstArm() =
    if pointerArm == 2 and errorArm == 2 then lastArm
    else if pointerArm == 2 then errorArm
    else if errorArm == 2 or pointerArm == errorArm then pointerArm
    else if pointerStoredLater then errorArm
    else pointerArm
  def heldLaterArm() =
    if pointerArm == 2 or errorArm == 2 or pointerArm == errorArm then 2
    else if pointerStoredLater then pointerArm
    else errorArm

  invariant ProgramShape {
    (forall edge: EarlierEdge {
      earlierX[edge] != NoPointerStore
      and earlierX[edge] != PointerFromX
      and earlierE[edge] != NoErrorStore
      and earlierE[edge] != ErrorFromE
    })
    and entryPointer != PointerFromX
    and entryError != ErrorFromE
    and (forall arm: Arm { armPointer[arm] != PointerFromX and armError[arm] != ErrorFromE })
  }
  invariant VerdictFixed {
    verdict == reported()
    and witnessFirstArm == firstArmOfPath()
    and witnessLaterArm == laterArmOfPath(firstArmOfPath())
    and witnessEarlierEdge == earlierEdgeOfPath(firstArmOfPath(), laterArmOfPath(firstArmOfPath()))
  }
  invariant FreshBeforeRun {
    (phase == Ready or phase == Joined) => (
      pointerArm == 2
      and errorArm == 2
      and lastArm == 2
      and rounds == 0
      and pointerIsNil
      and not pointerIsOutsideNil
      and errorIsBad == not trailingBool
    )
  }
  invariant FreshBeforeP {
    phase == Ready => (not onWitness and not xIsNil and not xIsOutsideNil and not eIsBad)
  }
  invariant FollowOnlyWhenReported { onWitness => verdict }
  invariant WitnessPath { verdict => pairs(witnessFirstArm, witnessLaterArm, witnessEarlierEdge) }
  invariant PTraced {
    phase != Ready => (
      xIsNil == (earlierX[earlierEdgeTaken] == PointerNil)
      and eIsBad == (earlierE[earlierEdgeTaken] == ErrorBad)
      and (xIsOutsideNil => earlierX[earlierEdgeTaken] == PointerOutside)
      and (onWitness => (earlierEdgeTaken == witnessEarlierEdge and not xIsOutsideNil))
    )
  }
  // The run's record agrees with the rule's reading of the store it holds.
  invariant RecordMatchesStore {
    (phase == InLoop or phase == LeftLoop) => (
      pointerIsNil == pointerStoreIsNil(heldPointerStore())
      and errorIsBad == errorStoreIsBad(heldErrorStore())
      and (pointerIsOutsideNil => heldPointerStore() == PointerOutside)
    )
  }
  invariant WitnessInOrder {
    (onWitness and (phase == InLoop or phase == LeftLoop)) => (
      rounds <= pathLength(witnessFirstArm, witnessLaterArm)
      and (rounds == 1 => (
        heldPointerStore() == loopPointerStore(witnessFirstArm, 2)
        and heldErrorStore() == loopErrorStore(witnessFirstArm, 2)))
      and (rounds == 2 => (
        heldPointerStore() == loopPointerStore(witnessFirstArm, witnessLaterArm)
        and heldErrorStore() == loopErrorStore(witnessFirstArm, witnessLaterArm)))
      and (phase == LeftLoop => rounds == pathLength(witnessFirstArm, witnessLaterArm))
      and (rounds == 0 => (heldPointerStore() == entryPointer and heldErrorStore() == entryError))
      and (heldPointerStore() == PointerOutside => not pointerIsOutsideNil)
    )
  }
  invariant Realizable {
    (phase == InLoop or phase == LeftLoop) => (
      heldPointerStore() == loopPointerStore(heldFirstArm(), heldLaterArm())
      and heldErrorStore() == loopErrorStore(heldFirstArm(), heldLaterArm())
      and ((phase == LeftLoop or rounds >= 1) => isPath(heldFirstArm(), heldLaterArm()))
    )
  }
  invariant LastArmKeptBoth {
    (rounds >= 1 => lastArm != 2)
    and (rounds == 0 => lastArm == 2)
    and ((pointerArm == 2 and errorArm == 2 and lastArm != 2) =>
          (armPointer[lastArm] == NoPointerStore and armError[lastArm] == NoErrorStore))
  }
  invariant SourcesStore {
    (pointerArm != 2 => armPointer[pointerArm] != NoPointerStore)
    and (errorArm != 2 => armError[errorArm] != NoErrorStore)
    and ((pointerArm == 2 and errorArm != 2) => armPointer[errorArm] == NoPointerStore)
    and ((errorArm == 2 and pointerArm != 2) => armError[pointerArm] == NoErrorStore)
    and ((pointerArm != 2 and errorArm != 2 and pointerArm != errorArm) => (
      if pointerStoredLater then armError[pointerArm] == NoErrorStore
      else armPointer[errorArm] == NoPointerStore
    ))
  }
  invariant OneArmUnlessLooped {
    not looped => (
      rounds <= 1
      and (pointerArm == 2 or errorArm == 2 or pointerArm == errorArm)
      and ((phase == LeftLoop or phase == Returned) => rounds == 1)
    )
  }
  invariant ZeroRoundsHoldTheEntry {
    ((phase == InLoop or phase == LeftLoop or phase == Returned) and rounds == 0) =>
      (pointerArm == 2 and errorArm == 2)
  }
  invariant ReturnedTraced {
    phase == Returned => (
      (pointerIsNil => pointerStoreIsNil(lastPointerStore(heldFirstArm(), heldLaterArm(), earlierEdgeTaken)))
      and (errorIsBad => errorStoreIsBad(lastErrorStore(heldFirstArm(), heldLaterArm(), earlierEdgeTaken)))
      and isPath(heldFirstArm(), heldLaterArm())
    )
  }

  // --- witnesses ------------------------------------------------------------------

  def noStoreAfterLoop() = afterPointer == NoPointerStore and afterError == NoErrorStore
  def storesBothFromEarlier() = afterPointer == PointerFromX and afterError == ErrorFromE

  // `if c { u = x } else { err = e }; return`. Each path stores one result.
  reachable ArmsKeptApart {
    phase == Returned
    and not reported()
    and not looped
    and not trailingBool
    and entryPointer == NoPointerStore
    and entryError == NoErrorStore
    and noStoreAfterLoop()
    and armPointer[0] == PointerNonNil
    and armError[0] == NoErrorStore
    and armPointer[1] == NoPointerStore
    and armError[1] == ErrorGood
  }
  // An arm that stores neither lets both zeros through: nil with a nil
  // error.
  reachable BothZerosThroughAnArm {
    phase == Returned
    and reported()
    and onWitness
    and not looped
    and not trailingBool
    and armPointer[witnessFirstArm] == NoPointerStore
    and armError[witnessFirstArm] == NoErrorStore
    and noStoreAfterLoop()
  }
  // The loop pairs a nil stored in one round with a nil error stored in the
  // next. No single arm does that.
  reachable PairAcrossRounds {
    phase == Returned
    and onWitness
    and looped
    and witnessLaterArm != 2
    and noStoreAfterLoop()
    and not pairsOnPath(witnessFirstArm, 2)
    and not pairsOnPath(witnessLaterArm, 2)
  }
  // u, err = x, e with x and e φ-nodes of P: paired along P, not reported.
  reachable StoredPhisKeptApart {
    phase == Returned
    and not reported()
    and storesBothFromEarlier()
    and earlierX[0] == PointerNil
    and earlierE[0] == ErrorGood
    and earlierX[1] == PointerOutside
    and earlierE[1] == ErrorBad
  }
  reachable StoredPhisReported {
    phase == Returned and onWitness and storesBothFromEarlier()
  }
  // The store after the loop kills everything before it.
  reachable AfterStoreKills {
    phase == Returned
    and not reported()
    and afterPointer == PointerNonNil
    and pairsOnPath(0, 2) == false
    and (exists first: ArmOrNone { exists later: ArmOrNone {
      isPath(first, later)
      and pointerStoreIsNil(loopPointerStore(first, later))
      and errorStoreIsBad(loopErrorStore(first, later))
    } })
  }
  // `e := err; p = nil; return p, e`: the pointer's store after the loop
  // still counts, beside the error loaded before it.
  reachable EarlyLoadKeepsLaterStore {
    phase == Returned
    and onWitness
    and errorLoadedEarly
    and afterPointer == PointerNil
    and not (exists first: ArmOrNone { exists later: ArmOrNone {
      isPath(first, later)
      and pointerStoreIsNil(loopPointerStore(first, later))
      and errorStoreIsBad(loopErrorStore(first, later))
    } })
  }
  // `e := err; err = nil; return p, e`: the error loaded early misses the
  // nil stored after it.
  reachable EarlyLoadMissesLaterStore {
    phase == Returned
    and not reported()
    and errorLoadedEarly
    and afterError == ErrorBad
    and pointerIsNil
  }
  // With a bool, the Alloc's zero is false. So there is nothing to pair.
  reachable BoolZeroIsFalse {
    phase == Returned
    and not reported()
    and trailingBool
    and pointerIsNil
    and entryError == NoErrorStore
    and errorArm == 2
    and afterError == NoErrorStore
  }
  // A nil from outside with a nil error is not reported. This is the gap.
  reachable OutsideNilIsMissed {
    phase == Returned and not reported() and pointerIsOutsideNil and errorIsBad
  }
}
