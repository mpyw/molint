// AN ACCEPTED GAP. It documents an accepted gap of the nil-value rule:
// conditions that correlate. design/rules.md lists it under Gaps.
//
// The rule reads a φ-node as a nil value when one of its edges brings the
// constant. It does not read the branch conditions that choose the edges.
// When two branches test the same condition, the nil edge and the return
// may never run together:
//
//   p := P0
//   if c { p = P1 }       p is φ(P0, P1)
//   if c { return p }     reported when P0 or P1 is nil
//   return &T{}
//
// With P0 = nil and P1 = &T{}, no run returns nil. When the second test is
// an independent condition d, a run does.
//
// The rule of nil_value.fsl computes the verdict from the program. The
// witness run is the run that verdict stands for: the nil edge of the
// φ-node, then the return. With the same condition, the second branch
// cannot take the return after the first edge. So ReportMeansANilIsReturned
// would break, and its negation ReportedNilIsNotReturned is reachable.
//
// design/rules.md defines a nil value as nil on some path, with branches
// taken as independent. nil_value.fsl proves that meaning under its
// ASSUME-1, which this file drops.
fsl 5
spec NilValueCorrelated {
  // Nil is the constant. NonNilLiteral is &T{}. Outside is f().
  enum Operand { Nil, NonNilLiteral, Outside }
  enum Value { NilConstant, NilOutside, NonNil }
  enum Phase { Ready, Joined, Returned }
  type ChoiceBit = 0..4

  state {
    phase: Phase,
    choice: Map<ChoiceBit, Bool>,
    // the program: P0, P1, and whether the second test is c again
    entryOperand: Operand,
    thenOperand: Operand,
    sameCondition: Bool,
    // the verdict, and the condition c that takes the nil edge
    verdict: Bool,
    witnessCondition: Bool,
    // the run
    firstCondition: Bool,
    pValue: Value,
    returnedP: Bool,
    returnedValue: Value,
    onWitness: Bool
  }

  def pickOperand(bit: ChoiceBit) =
    if choice[bit] then Nil
    else if choice[bit + 1] then NonNilLiteral
    else Outside

  init {
    phase = Ready
    entryOperand = pickOperand(0)
    thenOperand = pickOperand(2)
    sameCondition = choice[4]
    verdict = reported()
    witnessCondition = entryOperand != Nil
    firstCondition = false
    pValue = NonNil
    returnedP = false
    returnedValue = NonNil
    onWitness = false
  }

  // The rule of nil_value.fsl: a φ-node is a nil value when an edge brings
  // the constant. The witness takes the first such edge, so c is false when
  // P0 is nil.
  def reported() = entryOperand == Nil or thenOperand == Nil

  def operandValue(operand: Operand, outsideIsNil: Bool) =
    if operand == Nil then NilConstant
    else if operand == NonNilLiteral then NonNil
    else if outsideIsNil then NilOutside
    else NonNil

  action firstBranch(condition: Bool, outsideIsNil: Bool) {
    requires phase == Ready
    phase = Joined
    firstCondition = condition
    pValue =
      if condition then operandValue(thenOperand, outsideIsNil)
      else operandValue(entryOperand, outsideIsNil)
    onWitness = verdict and condition == witnessCondition and not outsideIsNil
  }

  // if c { return p } (the same condition), or if d { return p } (an
  // independent one).
  action secondBranch(secondCondition: Bool) {
    requires phase == Joined
    requires sameCondition => secondCondition == firstCondition
    phase = Returned
    returnedP = secondCondition
    returnedValue = if secondCondition then pValue else NonNil
    onWitness = onWitness and secondCondition
  }

  terminal { phase == Returned }

  // The negation of ReportMeansANilIsReturned in nil_value.fsl. With the same
  // condition, the witness run cannot take the return after the nil edge.
  reachable ReportedNilIsNotReturned {
    not (
      (onWitness and phase == Joined => (not sameCondition or firstCondition))
      and (onWitness and phase == Returned => returnedValue == NilConstant)
    )
  }

  reachable IndependentReturnsNil {
    phase == Returned
    and not sameCondition
    and returnedP
    and returnedValue == NilConstant
  }
  reachable SameReturnsNilThroughP1 {
    phase == Returned
    and sameCondition
    and onWitness
    and thenOperand == Nil
    and entryOperand != Nil
  }
}
