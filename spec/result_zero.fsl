// When result-zero reports a zero mo.Result. See "result-zero" in
// design/rules.md.
//
// A zero Result[T] is Ok, holding the zero value of T. A use of one is
// reported. It reaches the use through φ-nodes and through locals that are not
// lifted, as a nil value does. This spec shares the join of nil_value.fsl,
// with Zero in place of nil and a comparison with the zero Result in place of
// a nil check. It shares the kill by a later store of local_store.fsl. A local
// that is not lifted gives the same reaching stores as the φ-node here, so it
// is not modeled apart.
//
// The program:
//
//   r := E                         Zero: mo.Result[T]{}, var r, or *new(...)
//                                  Built: mo.Ok(v) or mo.Err(e)
//                                  Ext: a call's result
//   switch {                       three edges into a join; each arm stores
//   case c0: r = A0                A0..A2 or keeps r, and its edge may sit
//   case c1: r = A1                under a comparison of r with the zero
//   default: r = A2                Result: EqZero or NeZero
//   }
//   r = W                          or no store: an overwrite before the use
//   INSTR(r)
//
// INSTR is a use: a return, an argument, a conversion to an interface, a
// store into a field or an element, a method call. Or it is a comparison,
// which is not a use. The store that initializes r and the store a return
// makes into its result variable are not instructions here: design/rules.md
// judges the loads and the return in their place, and so does this model.
//
// `if r == (mo.Result[T]{}) { r = mo.Err(e) }; return r` is this shape with
// A0 = Err, and A1 = keep under NeZero.
//
// The rule, zeroAtUse below: an edge under NeZero brings no zero. An edge
// under EqZero brings one. Otherwise an edge brings one when its store, or
// the entry it keeps, is Zero. W kills everything before it. A value from
// outside is never a zero Result.
//
// The claim:
//
//   ReportMeansAZeroIsUsed    when reported, the witness run uses a zero
//                             Result that is a constant's, or that passed a
//                             comparison with the zero Result
//   ZeroConstantUseIsReported whenever a run uses a zero constant, it is
//                             reported
//
// ASSUME-1: branches are taken as independent, as the rule defines. The gap
//   when they correlate: nil_value_correlated.fsl.
// ASSUME-2: an edge under EqZero tests a value that some run makes zero, and
//   some edge can run, so the instruction is not dead code. The rule reports
//   dead code too, an accepted gap documented by nil_value_dead_check.fsl.
// ASSUME-3: from design/rules.md: a comparison with the zero constant on the
//   way stops a zero, as a nil check does. result_zero_nocheck.fsl models
//   the rejected reading that it does not.
// ASSUME-4 (representation only): one Result variable, three edges, one
//   comparison per edge, one instruction.
spec ResultZero {
  enum Op { Keep, Zero, Built, Ext }
  enum Cmp { NoCmp, EqZero, NeZero }
  enum Instr { Return, Argument, ToInterface, FieldStore, MethodCall, Compare }
  enum Val { ZeroConst, ZeroExt, NonZero }
  enum Pc { Ready, Judged, Joined, Done, Aborted }
  type Edge = 0..2
  type Bit = 0..18

  state {
    pc: Pc,
    ch: Map<Bit, Bool>,
    // the program
    e0: Op, a: Map<Edge, Op>, g: Map<Edge, Cmp>, w: Op, instr: Instr,
    // the verdict and its witness
    rep: Bool, wk: Edge, wzero: Bool,
    // the run
    r: Val, used: Val, follow: Bool
  }

  def pickEntry(i: Bit) = if ch[i] then Zero else if ch[i + 1] then Built else Ext
  def pickOp(i: Bit) =
    if ch[i] then (if ch[i + 1] then Keep else Zero) else (if ch[i + 1] then Built else Ext)
  def pickCmp(i: Bit) = if ch[i] then NoCmp else if ch[i + 1] then EqZero else NeZero
  def pickInstr(i: Bit) =
    if ch[i] then (if ch[i + 1] then Return else (if ch[i + 2] then Argument else ToInterface))
    else if ch[i + 1] then (if ch[i + 2] then FieldStore else MethodCall) else Compare

  init {
    pc = Ready
    e0 = pickEntry(0)
    forall k: Edge { a[k] = pickOp(2 + 2 * k)  g[k] = pickCmp(8 + 2 * k) }
    w = pickOp(14)  instr = pickInstr(16)
    rep = false  wk = 0  wzero = false
    r = NonZero  used = NonZero  follow = false
  }

  // --- the rule -------------------------------------------------------------------

  def isUse() = instr != Compare
  def zeroOn(k: Edge) = a[k] == Zero or (a[k] == Keep and e0 == Zero)
  def brings(k: Edge) = g[k] == EqZero or (g[k] == NoCmp and zeroOn(k))
  def zeroAtUse() = if w != Keep then w == Zero else (exists k: Edge { brings(k) })
  def reported() = isUse() and zeroAtUse()

  // What may be zero at run time, counting a call's result.
  def mayZeroOn(k: Edge) =
    a[k] == Zero or a[k] == Ext or (a[k] == Keep and (e0 == Zero or e0 == Ext))
  def mayNonZeroOn(k: Edge) =
    a[k] == Built or a[k] == Ext or (a[k] == Keep and (e0 == Built or e0 == Ext))
  def canPass(k: Edge) =
    g[k] == NoCmp or (g[k] == EqZero and mayZeroOn(k)) or (g[k] == NeZero and mayNonZeroOn(k))
  // ASSUME-2: no comparison is dead, and the instruction can run.
  def configOk() = (forall k: Edge { g[k] == EqZero => mayZeroOn(k) }) and (exists k: Edge { canPass(k) })

  // The witness: the first edge that brings a zero, and a call's result that
  // is zero only when that edge compares it.
  // After an overwrite, any edge that can run will do.
  def witnessEdge() =
    if w == Keep then (if brings(0) then 0 else if brings(1) then 1 else 2)
    else (if canPass(0) then 0 else if canPass(1) then 1 else 2)
  def witnessZero() = g[witnessEdge()] == EqZero

  action judge() {
    requires pc == Ready  requires configOk()
    pc = Judged
    rep = reported()  wk = witnessEdge()  wzero = witnessZero()
  }

  // --- the run --------------------------------------------------------------------

  def ev(o: Op, old: Val, zeroOut: Bool) =
    if o == Keep then old else if o == Zero then ZeroConst else if o == Built then NonZero
    else if zeroOut then ZeroExt else NonZero
  def passes(c: Cmp, v: Val) =
    if c == EqZero then v != NonZero else if c == NeZero then v == NonZero else true

  action arm(k: Edge, ze: Bool, za: Bool) {
    requires pc == Judged
    requires passes(g[k], ev(a[k], ev(e0, NonZero, ze), za))
    pc = Joined
    r = ev(a[k], ev(e0, NonZero, ze), za)
    follow = rep and k == wk and ze == wzero and za == wzero
  }

  // No edge may pass its comparison: the function panics or never returns.
  action abort() {
    requires pc == Judged
    pc = Aborted  follow = false
  }

  action use(zw: Bool) {
    requires pc == Joined
    pc = Done
    used = ev(w, r, zw)
    follow = follow and not zw
  }

  terminal { pc == Done or pc == Aborted or (pc == Ready and not configOk()) }

  // --- what is proved -------------------------------------------------------------

  // The witness is never blocked, and it uses a zero of the right origin.
  invariant ReportMeansAZeroIsUsed {
    (rep and pc == Judged => passes(g[wk], ev(a[wk], ev(e0, NonZero, wzero), wzero)))
    and ((follow and pc == Done) => (isUse() and (if w == Keep and wzero then used != NonZero else used == ZeroConst)))
  }
  invariant ZeroConstantUseIsReported {
    (pc == Done and used == ZeroConst and isUse()) => reported()
  }

  // --- auxiliary ------------------------------------------------------------------

  invariant ProgramShape { e0 != Keep and (pc != Ready => configOk()) }
  invariant VerdictFixed {
    pc != Ready => (rep == reported() and wk == witnessEdge() and wzero == witnessZero())
  }
  invariant FreshBeforeRun {
    (pc == Ready or pc == Judged) => (r == NonZero and used == NonZero and not follow)
  }
  invariant FollowOnlyWhenReported { follow => rep }
  invariant JoinedTraced {
    pc != Ready and pc != Judged => (r == ZeroConst => exists k: Edge {
      g[k] != NeZero and (g[k] == EqZero or zeroOn(k)) })
  }
  invariant WitnessJoined {
    (follow and pc == Joined and w == Keep) => (if wzero then r != NonZero else r == ZeroConst)
  }
  invariant UsedTraced {
    pc == Done => (used == ZeroConst => (w == Zero or (w == Keep and r == ZeroConst)))
  }

  // --- witnesses ------------------------------------------------------------------

  // var r mo.Result[T]; if c { r = mo.Ok(v) }; return r
  reachable ZeroThroughAJoin {
    pc == Done and reported() and instr == Return and e0 == Zero and a[0] == Built
    and used == ZeroConst
  }
  // if r == (mo.Result[T]{}) { r = mo.Err(e) }; return r
  reachable ComparisonStopsTheZero {
    pc == Done and not reported() and isUse() and w == Keep and e0 == Zero
    and a[0] == Built and a[1] == Keep and g[1] == NeZero and a[2] == Built
  }
  reachable ComparedZeroIsReported {
    pc == Done and reported() and g[wk] == EqZero and a[wk] == Ext and used == ZeroExt
  }
  reachable ComparisonIsNotAUse {
    pc == Done and not reported() and instr == Compare and used == ZeroConst
  }
  reachable OverwriteBeforeUse {
    pc == Done and not reported() and isUse() and w == Built
    and (exists k: Edge { brings(k) })
  }
  reachable ConversionToInterfaceIsAUse {
    pc == Done and reported() and instr == ToInterface and used == ZeroConst
  }
  reachable FieldStoreIsAUse {
    pc == Done and reported() and instr == FieldStore and used == ZeroConst
  }
  // The witness runs to the use, through a join and through an overwrite.
  reachable WitnessUsesAZero { follow and pc == Done and w == Keep and a[wk] == Keep }
  reachable WitnessAfterOverwrite { follow and pc == Done and w == Zero and g[wk] == NeZero }
  // A call's result that is zero, never compared: the gap.
  reachable OutsideZeroIsMissed { pc == Done and not reported() and isUse() and used == ZeroExt }
}
