// When result-zero reports a zero mo.Result. See "result-zero" in
// design/rules.md.
//
// A zero Result[T] is Ok, and it holds the zero value of T. A use of one is
// reported. A zero reaches the use through φ-nodes, as a nil value does. A
// comparison with the zero constant takes the place of a nil check. This
// spec has the shape of nil_value.fsl's join, with an earlier join in place
// of the loop.
//
// r is a variable that SSA lifts. A variable that SSA does not lift loads
// the stores that reach it. A comparison on an earlier load is not carried
// to a later one. That is an accepted gap (design/rules.md, Gaps, and
// local_store.fsl ASSUME-3). So this model is for lifted variables only.
//
// The program:
//
//   var r mo.Result[T]
//   if c { r = P0 } else { r = P1 }   an earlier join P: Zero, Built, Outside
//   switch {                          three edges into the join J. Each arm
//   case c0: r = A0                   stores A0..A2 or keeps r. Its edge may
//   case c1: r = A1                   sit under a comparison of r with the
//   default: r = A2                   zero Result: EqZero or NeZero
//   }
//   r = W                             or no store: an overwrite before the use
//   INSTR(r)
//
// In the state, P0 and P1 are earlierOperand. A0..A2 are armOperand, and
// their comparisons are armComparison. W is overwrite.
//
// Zero is mo.Result[T]{}, a `var r` not yet set, or *new(mo.Result[T]).
// Built is mo.Ok(v) or mo.Err(e). Outside is a call's result.
//
// `var r mo.Result[T]; if c { r = mo.Ok(v) }; if r == (mo.Result[T]{}) {
// r = mo.Err(e) }; use(r)` is this shape. P is φ(Zero, Built), A0 is Built,
// and A1 keeps r under NeZero.
//
// INSTR is a use: a return, an argument, a conversion to an interface, a
// store into a field or an element, or a method call. Or it is a
// comparison, which is not a use. The store that initializes r is not an
// instruction here. Nor is the store a return makes into its result
// variable. design/rules.md judges the loads and the return in their place,
// and so does this model.
//
// The rule, zeroAtUse below, works like this. An edge under NeZero brings
// no zero. An edge under EqZero brings one. Otherwise, an edge brings one
// when its store is Zero, or when it keeps a φ-node of P that is Zero. W
// kills everything before it. A value from outside is never a zero Result.
//
// The run keeps its own record of the value. It is the zero constant, a
// zero from outside, a zero that passed a comparison (ZeroChecked), or not
// zero.
//
// The claim:
//
//   ReportMeansAZeroIsUsed     when reported, the witness run is never
//                              blocked, and it uses a zero Result that is a
//                              constant's or that passed a comparison
//   ZeroUseIsReported          whenever a run uses such a zero, it is
//                              reported
//
// The run records whether its instruction passes the Result on (passedOn).
// It reads that from its own list of instructions. A comparison gives a
// bool instead. The claims are stated over that record. So a rule that
// counts a comparison as a use breaks ReportMeansAZeroIsUsed. The list
// itself is still a lookup. The model checks that the rule agrees with it,
// not that go/ssa does.
//
// ASSUME-1: branches are taken as independent, as the rule defines. The gap
//   when they correlate is nil_value_correlated.fsl.
// ASSUME-2: every comparison can pass on some run. So some edge can run,
//   and the instruction is not dead code. The rule reports dead code too.
//   That is an accepted gap, and nil_value_dead_check.fsl documents it.
// ASSUME-3: from design/rules.md, a comparison with the zero constant on
//   the way stops a zero, as a nil check does. result_zero_nocheck.fsl
//   models the rejected reading that it does not.
// ASSUME-4 (representation only): one Result variable, two edges into P,
//   three into J, one comparison per edge of J, and one instruction.
// ASSUME-5 (representation only): each edge of P stores a value. An edge of
//   P that kept r would keep the zero of `var r`, which is the same program
//   as one that stores Zero.
fsl 5
spec ResultZero {
  // KeepsR: the arm, or W, leaves r as it was. Zero is the zero Result.
  // Built is mo.Ok(v) or mo.Err(e). Outside is a call's result.
  enum Operand { KeepsR, Zero, Built, Outside }
  enum Comparison { NoComparison, EqZero, NeZero }
  enum Instruction { Return, Argument, ToInterface, FieldStore, MethodCall, Compare }
  enum Value { ZeroConstant, ZeroOutside, ZeroChecked, NonZero }
  enum Phase { Ready, PastEarlierJoin, Joined, Done, Aborted }
  type Edge = 0..2
  type EarlierEdge = 0..1

  state {
    phase: Phase,
    // the program. init leaves it unset, so it can be any program.
    earlierOperand: Map<EarlierEdge, Operand>,
    armOperand: Map<Edge, Operand>,
    armComparison: Map<Edge, Comparison>,
    overwrite: Operand,
    instruction: Instruction,
    // the verdict and its witness
    verdict: Bool,
    witnessEdge: Edge,
    witnessEarlierEdge: EarlierEdge,
    witnessOutsideZero: Bool,
    // the run
    earlierValue: Value,
    rValue: Value,
    usedValue: Value,
    passedOn: Bool,
    takenEdge: Edge,
    onWitness: Bool
  }

  // --- the rule -------------------------------------------------------------------

  def isUse() = instruction != Compare
  def earlierStoresZero() =
    exists earlierEdge: EarlierEdge { earlierOperand[earlierEdge] == Zero }
  def zeroOnEdge(edge: Edge) =
    armOperand[edge] == Zero or (armOperand[edge] == KeepsR and earlierStoresZero())
  def edgeBringsZero(edge: Edge) =
    armComparison[edge] == EqZero
    or (armComparison[edge] == NoComparison and zeroOnEdge(edge))
  def zeroAtUse() =
    if overwrite != KeepsR then overwrite == Zero
    else (exists edge: Edge { edgeBringsZero(edge) })
  def reported() = isUse() and zeroAtUse()

  // --- ASSUME-2 -------------------------------------------------------------------

  def mayBeZero(operand: Operand) = operand == Zero or operand == Outside
  def mayBeNonZero(operand: Operand) = operand == Built or operand == Outside
  def mayBeZeroOnEdge(edge: Edge) =
    mayBeZero(armOperand[edge])
    or (armOperand[edge] == KeepsR
        and (exists earlierEdge: EarlierEdge { mayBeZero(earlierOperand[earlierEdge]) }))
  def mayBeNonZeroOnEdge(edge: Edge) =
    mayBeNonZero(armOperand[edge])
    or (armOperand[edge] == KeepsR
        and (exists earlierEdge: EarlierEdge { mayBeNonZero(earlierOperand[earlierEdge]) }))
  def comparisonCanPass(edge: Edge) =
    (armComparison[edge] == EqZero => mayBeZeroOnEdge(edge))
    and (armComparison[edge] == NeZero => mayBeNonZeroOnEdge(edge))
  def everyComparisonCanPass() = forall edge: Edge { comparisonCanPass(edge) }

  // --- ASSUME-5 -------------------------------------------------------------------

  def everyEarlierEdgeStores() =
    forall earlierEdge: EarlierEdge { earlierOperand[earlierEdge] != KeepsR }
  def programRuns() = everyEarlierEdgeStores() and everyComparisonCanPass()

  // --- the witness ----------------------------------------------------------------

  // The value on an edge of J, when P took earlierEdge, and when every
  // call's result is zero (outsideZero) or not.
  def operandValue(operand: Operand, previous: Value, outsideZero: Bool) =
    if operand == KeepsR then previous
    else if operand == Zero then ZeroConstant
    else if operand == Built then NonZero
    else if outsideZero then ZeroOutside
    else NonZero
  def valueOnEdge(edge: Edge, earlierEdge: EarlierEdge, outsideZero: Bool) =
    operandValue(
      armOperand[edge],
      operandValue(earlierOperand[earlierEdge], NonZero, outsideZero),
      outsideZero)
  def passesComparison(comparison: Comparison, value: Value) =
    if comparison == EqZero then value != NonZero
    else if comparison == NeZero then value == NonZero
    else true
  def afterComparison(comparison: Comparison, value: Value) =
    if comparison == EqZero and value == ZeroOutside then ZeroChecked else value
  def reportableZero(value: Value) = value == ZeroConstant or value == ZeroChecked
  // What the witness needs at J. After an overwrite, it only needs to pass.
  def witnessWorksAt(edge: Edge, earlierEdge: EarlierEdge, outsideZero: Bool) =
    passesComparison(armComparison[edge], valueOnEdge(edge, earlierEdge, outsideZero))
    and (overwrite != KeepsR
         or reportableZero(afterComparison(armComparison[edge], valueOnEdge(edge, earlierEdge, outsideZero))))
  def witnessWorksOn(edge: Edge) =
    exists earlierEdge: EarlierEdge {
      witnessWorksAt(edge, earlierEdge, false) or witnessWorksAt(edge, earlierEdge, true)
    }
  def chooseWitnessEdge() =
    if overwrite == KeepsR then
      if edgeBringsZero(0) then 0
      else if edgeBringsZero(1) then 1
      else 2
    else
      if witnessWorksOn(0) then 0
      else if witnessWorksOn(1) then 1
      else 2
  def chooseWitnessOutsideZero(edge: Edge) =
    not (witnessWorksAt(edge, 0, false) or witnessWorksAt(edge, 1, false))
  def chooseWitnessEarlierEdge(edge: Edge, outsideZero: Bool) =
    if witnessWorksAt(edge, 0, outsideZero) then 0 else 1

  init {
    phase = Ready
    // The verdict and the witness read only the program.
    verdict = reported()
    witnessEdge = chooseWitnessEdge()
    witnessOutsideZero = chooseWitnessOutsideZero(chooseWitnessEdge())
    witnessEarlierEdge =
      chooseWitnessEarlierEdge(chooseWitnessEdge(), chooseWitnessOutsideZero(chooseWitnessEdge()))
    earlierValue = NonZero
    rValue = NonZero
    usedValue = NonZero
    passedOn = false
    takenEdge = 0
    onWitness = false
  }

  // --- the run --------------------------------------------------------------------

  action earlierJoin(earlierEdge: EarlierEdge, outsideZero: Bool) {
    requires phase == Ready
    requires programRuns()
    phase = PastEarlierJoin
    earlierValue = operandValue(earlierOperand[earlierEdge], NonZero, outsideZero)
    onWitness = verdict
                and earlierEdge == witnessEarlierEdge
                and outsideZero == witnessOutsideZero
  }

  action takeArm(edge: Edge, outsideZero: Bool) {
    requires phase == PastEarlierJoin
    requires passesComparison(armComparison[edge], operandValue(armOperand[edge], earlierValue, outsideZero))
    phase = Joined
    takenEdge = edge
    rValue = afterComparison(armComparison[edge], operandValue(armOperand[edge], earlierValue, outsideZero))
    onWitness = onWitness and edge == witnessEdge and outsideZero == witnessOutsideZero
  }

  // No edge may pass its comparison. The function then panics or never
  // returns.
  action abort() {
    requires phase == PastEarlierJoin
    phase = Aborted
    onWitness = false
  }

  action use(outsideZero: Bool) {
    requires phase == Joined
    phase = Done
    usedValue = operandValue(overwrite, rValue, outsideZero)
    // The run's own reading. Every instruction but a comparison passes the
    // Result on. A comparison gives a bool.
    passedOn = instruction == Return
               or instruction == Argument
               or instruction == ToInterface
               or instruction == FieldStore
               or instruction == MethodCall
    onWitness = onWitness and not outsideZero
  }

  terminal {
    phase == Done
    or phase == Aborted
    or (phase == Ready and not programRuns())
  }

  // --- what is proved -------------------------------------------------------------

  invariant ReportMeansAZeroIsUsed {
    (onWitness and phase == PastEarlierJoin =>
      passesComparison(
        armComparison[witnessEdge],
        operandValue(armOperand[witnessEdge], earlierValue, witnessOutsideZero)))
    and ((onWitness and phase == Done) => (passedOn and reportableZero(usedValue)))
  }
  invariant ZeroUseIsReported {
    (phase == Done and reportableZero(usedValue) and passedOn) => reported()
  }

  // --- auxiliary ------------------------------------------------------------------

  invariant ProgramShape { phase != Ready => programRuns() }
  invariant VerdictFixed {
    verdict == reported()
    and witnessEdge == chooseWitnessEdge()
    and witnessOutsideZero == chooseWitnessOutsideZero(chooseWitnessEdge())
    and witnessEarlierEdge
        == chooseWitnessEarlierEdge(chooseWitnessEdge(), chooseWitnessOutsideZero(chooseWitnessEdge()))
  }
  invariant FreshBeforeRun {
    phase == Ready => (
      earlierValue == NonZero
      and rValue == NonZero
      and usedValue == NonZero
      and not onWitness
      and not passedOn
    )
  }
  invariant FollowOnlyWhenReported { onWitness => verdict }
  invariant WitnessEdgeWorks {
    (verdict and everyComparisonCanPass()) =>
      witnessWorksAt(witnessEdge, witnessEarlierEdge, witnessOutsideZero)
  }
  invariant EarlyTraced {
    phase != Ready => (
      earlierValue != ZeroChecked
      and (earlierValue == ZeroConstant => earlierStoresZero())
      and (onWitness =>
            earlierValue == operandValue(earlierOperand[witnessEarlierEdge], NonZero, witnessOutsideZero))
    )
  }
  invariant JoinedTraced {
    (phase == Joined or phase == Done) => (
      (reportableZero(rValue) => (
        armComparison[takenEdge] == EqZero
        or (armComparison[takenEdge] == NoComparison and zeroOnEdge(takenEdge))))
      and (armComparison[takenEdge] == EqZero => rValue != NonZero)
      and (onWitness => (
        takenEdge == witnessEdge
        and rValue == afterComparison(
          armComparison[witnessEdge],
          valueOnEdge(witnessEdge, witnessEarlierEdge, witnessOutsideZero))))
    )
  }
  invariant UsedTraced {
    phase == Done => (
      (reportableZero(usedValue) => (overwrite == Zero or (overwrite == KeepsR and reportableZero(rValue))))
      and (overwrite == KeepsR => usedValue == rValue)
      and (passedOn == isUse())
    )
  }

  // --- witnesses ------------------------------------------------------------------

  // `var r mo.Result[T]; if c { r = mo.Ok(v) }; return r`
  reachable ZeroThroughAJoin {
    phase == Done
    and reported()
    and onWitness
    and instruction == Return
    and earlierOperand[witnessEarlierEdge] == Zero
    and armOperand[witnessEdge] == KeepsR
    and usedValue == ZeroConstant
  }
  // `if r == (mo.Result[T]{}) { r = mo.Err(e) }; return r`. Here r may be
  // zero or built, and the edge that keeps r runs.
  reachable ComparisonStopsTheZero {
    phase == Done
    and not reported()
    and isUse()
    and overwrite == KeepsR
    and earlierStoresZero()
    and armOperand[takenEdge] == KeepsR
    and armComparison[takenEdge] == NeZero
    and usedValue == NonZero
  }
  reachable ComparedZeroIsReported {
    phase == Done
    and reported()
    and onWitness
    and armComparison[witnessEdge] == EqZero
    and usedValue == ZeroChecked
  }
  reachable ComparisonIsNotAUse {
    phase == Done
    and not reported()
    and instruction == Compare
    and usedValue == ZeroConstant
  }
  reachable OverwriteBeforeUse {
    phase == Done
    and not reported()
    and isUse()
    and overwrite == Built
    and (exists edge: Edge { edgeBringsZero(edge) })
  }
  reachable WitnessAfterOverwrite {
    onWitness
    and phase == Done
    and overwrite == Zero
    and armComparison[witnessEdge] == NeZero
  }
  reachable ConversionToInterfaceIsAUse {
    phase == Done
    and reported()
    and instruction == ToInterface
    and usedValue == ZeroConstant
  }
  reachable FieldStoreIsAUse {
    phase == Done
    and reported()
    and instruction == FieldStore
    and usedValue == ZeroConstant
  }
  // A call's result that is zero and never compared: the gap.
  reachable OutsideZeroIsMissed {
    phase == Done
    and not reported()
    and isUse()
    and usedValue == ZeroOutside
  }
}
