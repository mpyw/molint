// AN ACCEPTED GAP. It documents an accepted consequence of return-nil. A
// return with operands is judged on the values it stores, whatever captures
// the result variables. See "return-nil" in design/rules.md.
//
//   func F() (p *T) {
//     defer func() { if p == nil { p = def } }()
//     return nil                reported: "F returns a nil *T"
//   }
//
// The return stores nil, and the deferred literal replaces it with def. So
// the caller gets def. The report stands on purpose: the return says nil.
//
// The program is `return V`, with V nil, &T{} or f(). The function's
// deferred literal keeps p, sets it non-nil, or sets it to f(). The run
// stores V, runs the literal, and loads p as the result.
//
// ReportMeansANilIsReturned is the claim the other specs prove. When the
// rule reports, the witness run returns the nil constant. It would break
// here, and that is the consequence the rules accept. So its negation,
// ReportedNilIsNotReturned, is reachable. local_store_escape.fsl
// holds the bare-return form, which loads p and is not followed.
fsl 5
spec ReturnStoreDeferred {
  // Nil is the constant. NonNilLiteral is &T{}. Outside is f().
  enum Operand { Nil, NonNilLiteral, Outside }
  enum Effect { Keeps, SetsNonNil, SetsOutside }
  enum Value { NilConstant, NilOutside, NonNil }
  enum Phase { Ready, Judged, Stored, Returned }
  type ChoiceBit = 0..3

  state {
    phase: Phase,
    choice: Map<ChoiceBit, Bool>,
    // the program: V, and what the deferred literal does to p
    returnOperand: Operand,
    deferredEffect: Effect,
    // the verdict
    verdict: Bool,
    // the run
    pValue: Value,
    returnedValue: Value,
    onWitness: Bool
  }

  init {
    phase = Ready
    returnOperand =
      if choice[0] then Nil
      else if choice[1] then NonNilLiteral
      else Outside
    deferredEffect =
      if choice[2] then Keeps
      else if choice[3] then SetsNonNil
      else SetsOutside
    verdict = false
    pValue = NonNil
    returnedValue = NonNil
    onWitness = false
  }

  // The rule as written: it judges the stored value.
  def reported() = returnOperand == Nil

  action judge() {
    requires phase == Ready
    phase = Judged
    verdict = reported()
  }

  action store(outsideNil: Bool) {
    requires phase == Judged
    phase = Stored
    pValue =
      if returnOperand == Nil then NilConstant
      else if returnOperand == NonNilLiteral then NonNil
      else if outsideNil then NilOutside
      else NonNil
    onWitness = verdict and not outsideNil
  }

  // The deferred literal runs. Then the function loads p as the result.
  action runDeferredAndLoad(outsideNil: Bool) {
    requires phase == Stored
    phase = Returned
    returnedValue =
      if deferredEffect == Keeps then pValue
      else if deferredEffect == SetsNonNil then NonNil
      else if outsideNil then NilOutside
      else NonNil
    onWitness = onWitness and not outsideNil
  }

  terminal { phase == Returned }

  // The negation of ReportMeansANilIsReturned in the other specs. The return
  // stores nil, and the deferred literal replaces it.
  reachable ReportedNilIsNotReturned {
    not ((onWitness and phase == Returned) => returnedValue == NilConstant)
  }

  reachable KeptNilIsReturned {
    phase == Returned
    and onWitness
    and deferredEffect == Keeps
    and returnedValue == NilConstant
  }
}
