// FAILS ON PURPOSE. This is the pairing of a bare return that judges each
// load on its own reaching stores, and the counterexample is the reason
// pairing_stores.fsl reads both results on the same path.
//
//   func F() (u *T, err error) {
//     defer mu.Unlock()
//     if c { u = x } else { err = e }
//     return                      reported: "F returns a nil *T with a nil error"
//   }
//
// The load of u is reached by the zero of its Alloc through the else arm. The
// load of err is reached by its zero through the then arm. No run returns nil
// with a nil error.
//
// The program, the run and the claim are those of pairing_stores.fsl, except
// for reported() and the witness, which takes the path that gave the error.
// The run is limited to programs that pairing_stores.fsl's rule does not
// report, so every report here is this rule's own.
spec PairingBareReturn {
  enum UStore { UKeep, UNil, UAlloc, UExt, UFromP }
  enum EStore { EKeep, EBad, EGood, EOut, EFromP }
  enum Pc { Ready, Joined, Loop, Left, Returned }
  // An arm, or 2: no arm (the entry's store, or no round at all).
  type Step = 0..2
  type Arm = 0..1
  type Pre = 0..1
  type Rounds = 0..2
  type Bit = 0..27

  state {
    pc: Pc,
    ch: Map<Bit, Bool>,
    // the program
    px: Map<Pre, UStore>, py: Map<Pre, EStore>,
    u0: UStore, e0: EStore, us: Map<Arm, UStore>, es: Map<Arm, EStore>,
    au: UStore, ae: EStore, looped: Bool, isBool: Bool,
    // the verdict and its witness path
    rep: Bool, wx: Step, wy: Step, we: Pre,
    // the run: which store each result holds, and which came last
    uSrc: Step, eSrc: Step, uLater: Bool, lastArm: Step, rounds: Rounds, taken: Pre,
    // the run's own record of the values
    xNil: Bool, xOut: Bool, eBadP: Bool,
    uv: Bool, uOut: Bool, eb: Bool, follow: Bool
  }

  def pickU(i: Bit) =
    if ch[i] then (if ch[i + 1] then UKeep else UNil) else (if ch[i + 1] then UAlloc else UExt)
  def pickE(i: Bit) =
    if ch[i] then (if ch[i + 1] then EKeep else EBad) else (if ch[i + 1] then EGood else EOut)
  def pickPU(i: Bit) = if ch[i] then UNil else if ch[i + 1] then UAlloc else UExt
  def pickPE(i: Bit) = if ch[i] then EBad else if ch[i + 1] then EGood else EOut
  def pickAU(i: Bit) = if ch[i] then pickU(i + 1) else UFromP
  def pickAE(i: Bit) = if ch[i] then pickE(i + 1) else EFromP

  // --- the rule -------------------------------------------------------------------

  // What a store gives. UKeep and EKeep at the entry stand for the Alloc's zero.
  def uNil(s: UStore) = s == UKeep or s == UNil
  def eBad(s: EStore) = s == EBad or (s == EKeep and not isBool)
  // The last store of each result on the path x, then y, then the store after
  // the loop; x and e from P are read along P's edge p.
  def loopU(x: Step, y: Step) =
    if y != 2 and us[y] != UKeep then us[y] else if x != 2 and us[x] != UKeep then us[x] else u0
  def loopE(x: Step, y: Step) =
    if y != 2 and es[y] != EKeep then es[y] else if x != 2 and es[x] != EKeep then es[x] else e0
  def finU(x: Step, y: Step, p: Pre) =
    if au == UFromP then px[p] else if au != UKeep then au else loopU(x, y)
  def finE(x: Step, y: Step, p: Pre) =
    if ae == EFromP then py[p] else if ae != EKeep then ae else loopE(x, y)
  def path(x: Step, y: Step) = if looped then (x == 2 => y == 2) else (x != 2 and y == 2)
  def pairs(x: Step, y: Step, p: Pre) = path(x, y) and uNil(finU(x, y, p)) and eBad(finE(x, y, p))
  def pairsAt(x: Step, y: Step) = exists p: Pre { pairs(x, y, p) }
  // THE NAIVE RULE: each load is judged on its own reaching stores.
  def uReach(x: Step, y: Step) = exists p: Pre { path(x, y) and uNil(finU(x, y, p)) }
  def eReach(x: Step, y: Step, p: Pre) = path(x, y) and eBad(finE(x, y, p))
  def reported() =
    (exists x: Step { exists y: Step { uReach(x, y) } })
    and (exists x: Step { exists y: Step { exists p: Pre { eReach(x, y, p) } } })
  // The rule of pairing_stores.fsl, to pick the programs it does not report.
  def provedReported() = exists x: Step { exists y: Step { pairsAt(x, y) } }

  // The witness runs the path that makes the error Bad.
  def eAt(x: Step, y: Step) = exists p: Pre { eReach(x, y, p) }
  def firstX() =
    if exists y: Step { eAt(0, y) } then 0 else if exists y: Step { eAt(1, y) } then 1 else 2
  def firstY(x: Step) = if eAt(x, 0) then 0 else if eAt(x, 1) then 1 else 2
  def firstP(x: Step, y: Step) = if eReach(x, y, 0) then 0 else 1
  def len(x: Step, y: Step) = (if x != 2 then 1 else 0) + (if y != 2 then 1 else 0)

  init {
    pc = Ready
    forall p: Pre { px[p] = pickPU(4 * p)  py[p] = pickPE(4 * p + 2) }
    u0 = pickU(8)  e0 = pickE(10)
    forall k: Arm { us[k] = pickU(12 + 4 * k)  es[k] = pickE(14 + 4 * k) }
    au = pickAU(20)  ae = pickAE(23)  looped = ch[26]  isBool = ch[27]
    // The verdict and the witness read only the program set above.
    rep = reported()  wx = firstX()  wy = firstY(firstX())  we = firstP(firstX(), firstY(firstX()))
    uSrc = 2  eSrc = 2  uLater = false  lastArm = 2  rounds = 0  taken = 0
    xNil = false  xOut = false  eBadP = false
    uv = true  uOut = false  eb = not isBool  follow = false
  }

  // --- the run --------------------------------------------------------------------

  // The run's own reading of a store: nil constant, nil from outside, Bad.
  def storesNil(s: UStore, old: Bool) = if s == UKeep then old else s == UNil
  def storesOut(s: UStore, n: Bool, old: Bool) = if s == UKeep then old else (s == UExt and n)
  def storesBad(s: EStore, old: Bool) = if s == EKeep then old else s == EBad

  action passP(p: Pre, n: Bool) {
    requires pc == Ready  requires not provedReported()
    pc = Joined  taken = p
    xNil = px[p] == UNil  xOut = px[p] == UExt and n  eBadP = py[p] == EBad
    follow = rep and p == we and not n
  }

  action enter(n: Bool) {
    requires pc == Joined
    pc = Loop
    uv = storesNil(u0, uv)  uOut = storesOut(u0, n, uOut)  eb = storesBad(e0, eb)
    follow = follow and not n
  }

  action round(k: Arm, n: Bool) {
    requires pc == Loop  requires looped or rounds == 0
    uv = storesNil(us[k], uv)  uOut = storesOut(us[k], n, uOut)  eb = storesBad(es[k], eb)
    uSrc = if us[k] != UKeep then k else uSrc
    eSrc = if es[k] != EKeep then k else eSrc
    uLater = if us[k] != UKeep and es[k] == EKeep then true
             else if es[k] != EKeep then false else uLater
    lastArm = k
    rounds = min(rounds + 1, 2)
    follow = follow and rounds < len(wx, wy) and (if rounds == 0 then k == wx else k == wy) and not n
  }

  action leave() {
    requires pc == Loop  requires looped or rounds == 1
    pc = Left
    follow = follow and rounds == len(wx, wy)
  }

  // The store after the loop, then the bare return's loads.
  action ret(n: Bool) {
    requires pc == Left
    pc = Returned
    uv = if au == UFromP then xNil else storesNil(au, uv)
    uOut = if au == UFromP then xOut else storesOut(au, n, uOut)
    eb = if ae == EFromP then eBadP else storesBad(ae, eb)
    follow = follow and not n
  }

  terminal { pc == Returned }

  // --- what is proved -------------------------------------------------------------

  // Never blocked: each round and the exit the witness takes are enabled.
  invariant WitnessNeverBlocked {
    (follow and pc == Loop) => (
      (rounds < len(wx, wy) => (looped or rounds == 0))
      and (rounds == len(wx, wy) => (looped or rounds == 1))
    )
  }
  invariant ReportMeansNilWithBad { (follow and pc == Returned) => (uv and eb) }
  invariant NilWithBadIsReported { (pc == Returned and uv and eb) => reported() }

  // The auxiliary invariants of the proved spec are left out: a failing
  // spec needs no induction, and each must break on its claim.

  // --- witnesses ------------------------------------------------------------------

  // if c { u = x } else { err = e }; return: each path stores one result.
  reachable ArmsKeptApart {
    pc == Returned and not reported() and not looped and not isBool
    and u0 == UKeep and e0 == EKeep and au == UKeep and ae == EKeep
    and us[0] == UAlloc and es[0] == EKeep and us[1] == UKeep and es[1] == EGood
  }
  // An arm that stores neither lets both zeros through: nil with a nil error.
  reachable BothZerosThroughAnArm {
    pc == Returned and reported() and follow and not looped and not isBool
    and us[wx] == UKeep and es[wx] == EKeep and au == UKeep and ae == EKeep
  }
  // The loop pairs a nil stored in one round with a nil error stored in the
  // next, which no single arm does.
  reachable PairAcrossRounds {
    pc == Returned and follow and looped and wy != 2 and au == UKeep and ae == EKeep
    and not pairsAt(wx, 2) and not pairsAt(wy, 2)
  }
  // u, err = x, e with x, e φ-nodes of P: paired along P, not reported.
  reachable StoredPhisKeptApart {
    pc == Returned and not reported() and au == UFromP and ae == EFromP
    and px[0] == UNil and py[0] == EGood and px[1] == UExt and py[1] == EBad
  }
  reachable StoredPhisReported {
    pc == Returned and follow and au == UFromP and ae == EFromP
  }
  // The store after the loop kills everything before it.
  reachable AfterStoreKills {
    pc == Returned and not reported() and au == UAlloc and pairsAt(0, 2) == false
    and (exists x: Step { exists y: Step { path(x, y) and uNil(loopU(x, y)) and eBad(loopE(x, y)) } })
  }
  // With a bool, the zero of the Alloc is false: nothing to pair.
  reachable BoolZeroIsFalse {
    pc == Returned and not reported() and isBool and uv and e0 == EKeep and eSrc == 2 and ae == EKeep
  }
  // A nil from outside with a nil error is not reported. The gap.
  reachable OutsideNilIsMissed { pc == Returned and not reported() and uOut and eb }
}
