// FAILS ON PURPOSE. This is the rule that follows a variable whose address
// escapes. Its counterexample is the reason such a variable is not
// followed.
//
// The code that holds the address may store into the variable, and the
// rule does not see that store:
//
//   func F() (p *T) {
//     p = nil
//     defer func() { if p == nil { p = def } }()
//     return                    reported: "F returns a nil *T"
//   }
//
// The bare return loads p after the deferred literal stored def. `&p`
// passed to a call that sets it is the same.
//
// A return with operands is different. design/rules.md judges it on the
// values it stores. So `return nil` in place of the bare return above is
// reported on purpose, and return_store_deferred.fsl documents that.
//
// The program, the run and the claim are those of local_store.fsl, except
// for followed. The run is limited to programs that local_store.fsl's rule
// does not report. So every report here is this rule's own.
fsl 5
spec LocalStoreEscape {
  // NoStore: no store there. At the entry, the Alloc's zero then reaches.
  // StoresNonNil is &T{}, and StoresOutside is f().
  enum Store { NoStore, StoresNil, StoresNonNil, StoresOutside }
  enum Escape { NoEscape, LoadsOnly, StoresInto, AddrPassed }
  enum Effect { Keeps, SetsNonNil, SetsOutside }
  enum Value { NilConstant, NilOutside, NonNil }
  enum Phase { Ready, Judged, InLoop, LeftLoop, Loaded }
  type Arm = 0..2
  type Rounds = 0..2
  type ChoiceBit = 0..15

  state {
    phase: Phase,
    choice: Map<ChoiceBit, Bool>,
    // the program
    entryStore: Store,
    armStore: Map<Arm, Store>,
    looped: Bool,
    escape: Escape,
    escapeEffect: Effect,
    escapeDeferred: Bool,
    laterStore: Store,
    // the verdict and its witness
    verdict: Bool,
    witnessArm: Arm,
    witnessRounds: Rounds,
    // the run
    xValue: Value,
    rounds: Rounds,
    loadedValue: Value,
    onWitness: Bool
  }

  def pickStore(bit: ChoiceBit) =
    if choice[bit] then (if choice[bit + 1] then NoStore else StoresNil)
    else (if choice[bit + 1] then StoresNonNil else StoresOutside)
  def pickEscape(bit: ChoiceBit) =
    if choice[bit] then (if choice[bit + 1] then NoEscape else LoadsOnly)
    else (if choice[bit + 1] then StoresInto else AddrPassed)
  def pickEffect(bit: ChoiceBit) =
    if choice[bit] then Keeps else if choice[bit + 1] then SetsNonNil else SetsOutside

  init {
    phase = Ready
    entryStore = pickStore(0)
    forall armIndex: Arm { armStore[armIndex] = pickStore(2 + 2 * armIndex) }
    looped = choice[8]
    escape = pickEscape(9)
    escapeEffect = pickEffect(11)
    escapeDeferred = choice[13]
    laterStore = pickStore(14)
    verdict = false
    witnessArm = 0
    witnessRounds = 0
    xValue = NonNil
    rounds = 0
    loadedValue = NonNil
    onWitness = false
  }

  // --- the rule -------------------------------------------------------------------

  // THE NAIVE RULE: every variable is followed, whatever holds its address.
  def followed() = true
  // The rule of local_store.fsl, to pick the programs it does not report.
  def provedReported() = (escape == NoEscape or escape == LoadsOnly) and loadIsNil()
  def entryStoresNil() = entryStore == NoStore or entryStore == StoresNil
  def someArmStoresNil() = exists armIndex: Arm { armStore[armIndex] == StoresNil }
  def someArmKeeps() = exists armIndex: Arm { armStore[armIndex] == NoStore }
  def nilReachesLoopExit() =
    someArmStoresNil() or (entryStoresNil() and (looped or someArmKeeps()))
  def loadIsNil() =
    if laterStore != NoStore then laterStore == StoresNil else nilReachesLoopExit()
  def reported() = followed() and loadIsNil()

  // The witness.
  def firstNilArm() =
    if armStore[0] == StoresNil then 0 else if armStore[1] == StoresNil then 1 else 2
  def firstKeepArm() =
    if armStore[0] == NoStore then 0 else if armStore[1] == NoStore then 1 else 2
  def chooseWitnessArm() = if someArmStoresNil() then firstNilArm() else firstKeepArm()
  def chooseWitnessRounds() =
    if laterStore == NoStore and not someArmStoresNil() and looped then 0 else 1

  action judge() {
    requires phase == Ready
    requires not provedReported()
    phase = Judged
    verdict = reported()
    witnessArm = chooseWitnessArm()
    witnessRounds = chooseWitnessRounds()
  }

  // --- the run --------------------------------------------------------------------

  def storeValue(storeKind: Store, previous: Value, outsideIsNil: Bool) =
    if storeKind == NoStore then previous
    else if storeKind == StoresNil then NilConstant
    else if storeKind == StoresNonNil then NonNil
    else if outsideIsNil then NilOutside
    else NonNil
  def escapes() = escape == StoresInto or escape == AddrPassed
  def applyEscape(previous: Value, outsideIsNil: Bool) =
    if not escapes() or escapeEffect == Keeps then previous
    else if escapeEffect == SetsNonNil then NonNil
    else if outsideIsNil then NilOutside
    else NonNil

  action enter(outsideNil: Bool) {
    requires phase == Judged
    phase = InLoop
    xValue = storeValue(entryStore, NilConstant, outsideNil)
    onWitness = verdict and not outsideNil
  }

  action round(armIndex: Arm, outsideNil: Bool) {
    requires phase == InLoop
    requires looped or rounds == 0
    xValue = storeValue(armStore[armIndex], xValue, outsideNil)
    rounds = min(rounds + 1, 2)
    onWitness = onWitness
                and rounds < witnessRounds
                and armIndex == witnessArm
                and not outsideNil
  }

  action leave() {
    requires phase == InLoop
    requires looped or rounds == 1
    phase = LeftLoop
    onWitness = onWitness and rounds == witnessRounds
  }

  // The escape point, the store S3, the deferred escape, then the load.
  action load(escapeOutsideNil: Bool, laterOutsideNil: Bool) {
    requires phase == LeftLoop
    phase = Loaded
    loadedValue =
      if escapeDeferred then
        applyEscape(storeValue(laterStore, xValue, laterOutsideNil), escapeOutsideNil)
      else
        storeValue(laterStore, applyEscape(xValue, escapeOutsideNil), laterOutsideNil)
    onWitness = onWitness and not escapeOutsideNil and not laterOutsideNil
  }

  terminal { phase == Loaded }

  // --- what is proved -------------------------------------------------------------

  invariant WitnessNeverBlocked {
    (onWitness and phase == InLoop) => (
      (rounds < witnessRounds => (looped or rounds == 0))
      and (rounds == witnessRounds => (looped or rounds == 1))
    )
  }
  invariant ReportMeansANilIsLoaded {
    (onWitness and phase == Loaded) => loadedValue == NilConstant
  }
  invariant ConstantNilIsReported {
    (phase == Loaded and loadedValue == NilConstant and not escapes()) => reported()
  }

  // The auxiliary invariants of the proved spec are left out. A failing
  // spec needs no induction, and each spec must break on its claim.

  // --- witnesses ------------------------------------------------------------------

  def everyArmStoresNonNil() = forall armIndex: Arm { armStore[armIndex] == StoresNonNil }

  // `var p *T; defer func() { log(p) }(); if c { p = x }; return`
  reachable LoadOnlyCaptureIsFollowed {
    phase == Loaded
    and reported()
    and escape == LoadsOnly
    and laterStore == NoStore
    and loadedValue == NilConstant
  }
  // `p = nil; defer func() { p = def }(); return`. The load gives the
  // deferred store.
  reachable DeferredStoreIsNotFollowed {
    phase == Loaded
    and not reported()
    and escape == StoresInto
    and escapeDeferred
    and laterStore == StoresNil
    and escapeEffect == SetsNonNil
    and loadedValue == NonNil
  }
  // The witness runs to the load, through an arm and through the loop.
  reachable WitnessThroughAnArm {
    onWitness
    and phase == Loaded
    and rounds == 1
    and armStore[witnessArm] == StoresNil
  }
  reachable WitnessSkipsTheLoop { onWitness and phase == Loaded and rounds == 0 and looped }
  // The variable is not followed, so a nil that is loaded goes unreported.
  // This is the gap.
  reachable EscapedNilIsMissed {
    phase == Loaded
    and not reported()
    and escapes()
    and loadedValue == NilConstant
  }
  // Every arm stores &T{}. Without a loop, the entry's nil does not reach.
  reachable ArmsKillTheEntry {
    phase == Loaded
    and not reported()
    and not looped
    and entryStoresNil()
    and laterStore == NoStore
    and everyArmStoresNonNil()
    and followed()
  }
  // The same arms in a loop that may run zero times: the entry's nil
  // reaches.
  reachable LoopLetsTheEntryReach {
    phase == Loaded
    and reported()
    and looped
    and entryStoresNil()
    and laterStore == NoStore
    and everyArmStoresNonNil()
    and rounds == 0
    and loadedValue == NilConstant
  }
  // An arm that stores nil, after an entry that is not nil, with another arm
  // after it in program order.
  reachable NilFromAnEarlierArm {
    phase == Loaded
    and reported()
    and entryStore == StoresNonNil
    and armStore[0] == StoresNil
    and armStore[2] == StoresNonNil
    and laterStore == NoStore
    and loadedValue == NilConstant
  }
  reachable OverwriteBeforeLoad {
    phase == Loaded
    and not reported()
    and nilReachesLoopExit()
    and laterStore == StoresNonNil
    and followed()
  }
}
