// Pairing a φ-node with a load. This is return-nil when the error is a
// variable that SSA does not lift, read at the return. See "return-nil" in
// design/rules.md.
//
// A function literal that only loads err keeps err in memory, and keeps it
// followed. The return then pairs a φ-node u with a load of err. pairStep
// in internal/flow/pair.go reads that load along each edge into the
// φ-node's block. On an edge, the load is the stores that reach it on a
// path through that edge, one alternative per store.
//
// The program:
//
//   var u *T
//   var err error                     the Alloc: a store of nil
//   defer func() { log(err) }()       only loads err
//   if a { err = P0 } else { err = P1 }   an earlier if. Each arm may store
//   switch {                          three edges into the switch's join.
//   case c0: u, err = U0, E0          Each arm sets u, and may store err
//   case c1: u, err = U1, E1
//   default: u, err = U2, E2
//   }
//   if d { err = L }                  a later if, or none (hasLaterIf). Its
//                                     arm may store nothing
//   return u, err                     u is a φ-node, err a load
//
// In the state, P0 and P1 are earlierStore. U0..U2 are armPointer, E0..E2
// are armError, and L is laterStore.
//
// The stores into err are Bad (nil), Good (errors.New) or Out (f()), or
// nothing (NoErrorStore). u is nil, &T{} or f().
//
// This program has the shape, and it is not reported. On the edge where u
// is nil, err holds e:
//
//   var u *T
//   var err error
//   defer func() { log(err) }()
//   if b { u = x } else { err = e }
//   return u, err
//
// Nor is the same with `if cond() { log() }` before the return. The load
// then sits in a later block than the φ-node.
//
// The rule, reported below, works as pairStoresOnEdge does. It needs some
// edge that brings the nil constant for u. It walks back from the load and
// collects the stores into err that reach it on a path through that edge.
// L is one, when it stores. A path that skips the later if reaches the
// switch, and so does a path through an arm of it that stores nothing.
// There the walk reads what reaches the end of the edge's arm. That is the
// arm's own E, or P0, P1 and the Alloc's zero when the arm stores nothing.
// The rule reports when one of the stores it collected stores Bad.
//
// The run keeps its own record: whether u and err hold the constants. It
// takes one path. So the claims compare the stores a walk collects with
// the store one path leaves.
//
// The claim:
//
//   ReportMeansNilWithBad   when reported, the witness run returns the nil
//                           constant with the nil error constant
//   NilWithBadIsReported    whenever a run returns them, it is reported
//
// ASSUME-1: branches are taken as independent, as the rule defines.
// ASSUME-2 (representation only): the trailing result is an error. A bool
//   pairs the same way (pairing.fsl, pairing_stores.fsl).
fsl 5
spec PairingLoad {
  // NonNilLiteral is &T{}, and Outside is f(). NoErrorStore: the arm
  // stores nothing into err.
  enum PointerOperand { Nil, NonNilLiteral, Outside }
  enum ErrorStore { NoErrorStore, ErrorBad, ErrorGood, ErrorOutside }
  enum Phase { Ready, PastEarlierIf, PastSwitch, Returned }
  type Edge = 0..2
  type EarlierEdge = 0..1

  state {
    phase: Phase,
    // the program. init leaves it unset, so it can be any program.
    earlierStore: Map<EarlierEdge, ErrorStore>,
    armPointer: Map<Edge, PointerOperand>,
    armError: Map<Edge, ErrorStore>,
    hasLaterIf: Bool,
    laterStore: ErrorStore,
    // the verdict and its witness
    verdict: Bool,
    witnessEdge: Edge,
    witnessEarlierEdge: EarlierEdge,
    witnessLaterTaken: Bool,
    // the run's own record
    errIsBadBeforeSwitch: Bool,
    pointerIsNil: Bool,
    pointerIsOutsideNil: Bool,
    errorIsBad: Bool,
    onWitness: Bool,
    // the path the run took
    takenEarlierEdge: EarlierEdge,
    takenEdge: Edge,
    laterTaken: Bool
  }

  // --- the rule -------------------------------------------------------------------

  // The Alloc's zero is the nil error.
  def storeIsBad(store: ErrorStore) = store == ErrorBad or store == NoErrorStore
  // Some store that reaches the end of the arm on this edge stores Bad.
  def badStoreReachesArmEnd(edge: Edge) =
    if armError[edge] != NoErrorStore then armError[edge] == ErrorBad
    else exists earlierEdge: EarlierEdge { storeIsBad(earlierStore[earlierEdge]) }
  // Some store that reaches the load through this edge stores Bad: L, or
  // a store that reaches the end of the arm.
  def badStoreReachesLoad(edge: Edge) =
    (hasLaterIf and laterStore == ErrorBad)
    or badStoreReachesArmEnd(edge)
  def pairsOnEdge(edge: Edge) =
    armPointer[edge] == Nil
    and badStoreReachesLoad(edge)
  def reported() = exists edge: Edge { pairsOnEdge(edge) }

  // The witness: the first edge that pairs. It takes the later if when L
  // stores Bad. Otherwise it takes the earlier if's first edge whose
  // store is Bad.
  def firstEdge() =
    if pairsOnEdge(0) then 0
    else if pairsOnEdge(1) then 1
    else 2
  def firstEarlierEdge() = if storeIsBad(earlierStore[0]) then 0 else 1
  def laterStoresBad() = hasLaterIf and laterStore == ErrorBad

  init {
    phase = Ready
    // The verdict and the witness read only the program.
    verdict = reported()
    witnessEdge = firstEdge()
    witnessEarlierEdge = firstEarlierEdge()
    witnessLaterTaken = laterStoresBad()
    errIsBadBeforeSwitch = true
    pointerIsNil = false
    pointerIsOutsideNil = false
    errorIsBad = false
    onWitness = false
    takenEarlierEdge = 0
    takenEdge = 0
    laterTaken = false
  }

  // --- the run --------------------------------------------------------------------

  action earlierIf(earlierEdge: EarlierEdge) {
    requires phase == Ready
    phase = PastEarlierIf
    takenEarlierEdge = earlierEdge
    errIsBadBeforeSwitch =
      if earlierStore[earlierEdge] == NoErrorStore then errIsBadBeforeSwitch
      else earlierStore[earlierEdge] == ErrorBad
    onWitness = verdict and earlierEdge == witnessEarlierEdge
  }

  action takeArm(edge: Edge, outsideNil: Bool) {
    requires phase == PastEarlierIf
    phase = PastSwitch
    takenEdge = edge
    pointerIsNil = armPointer[edge] == Nil
    pointerIsOutsideNil = armPointer[edge] == Outside and outsideNil
    errorIsBad =
      if armError[edge] == NoErrorStore then errIsBadBeforeSwitch
      else armError[edge] == ErrorBad
    onWitness = onWitness and edge == witnessEdge and not outsideNil
  }

  // The later if, taken or not, then the return.
  action laterIf(later: Bool) {
    requires phase == PastSwitch
    requires hasLaterIf or not later
    phase = Returned
    laterTaken = later
    errorIsBad =
      if later and laterStore != NoErrorStore then laterStore == ErrorBad
      else errorIsBad
    onWitness = onWitness and later == witnessLaterTaken
  }

  terminal { phase == Returned }

  // --- what is proved -------------------------------------------------------------

  invariant ReportMeansNilWithBad {
    (onWitness and phase == Returned) => (pointerIsNil and errorIsBad)
  }
  invariant NilWithBadIsReported {
    (phase == Returned and pointerIsNil and errorIsBad) => reported()
  }

  // --- auxiliary ------------------------------------------------------------------

  // What err holds at the end of one path, for the lemmas below. The rule
  // never reads these.
  def badAtArmEnd(edge: Edge, earlierEdge: EarlierEdge) =
    if armError[edge] != NoErrorStore then armError[edge] == ErrorBad
    else storeIsBad(earlierStore[earlierEdge])
  def badAtLoad(edge: Edge, earlierEdge: EarlierEdge, later: Bool) =
    if later and laterStore != NoErrorStore then laterStore == ErrorBad
    else badAtArmEnd(edge, earlierEdge)
  def pathPairs(edge: Edge, earlierEdge: EarlierEdge, later: Bool) =
    (hasLaterIf or not later)
    and armPointer[edge] == Nil
    and badAtLoad(edge, earlierEdge, later)

  invariant VerdictFixed {
    verdict == reported()
    and witnessEdge == firstEdge()
    and witnessEarlierEdge == firstEarlierEdge()
    and witnessLaterTaken == laterStoresBad()
  }
  invariant FreshBeforeRun {
    phase == Ready => (
      errIsBadBeforeSwitch
      and not pointerIsNil
      and not pointerIsOutsideNil
      and not errorIsBad
      and not onWitness
    )
  }
  invariant FollowOnlyWhenReported { onWitness => verdict }
  invariant WitnessWorks { verdict => pathPairs(witnessEdge, witnessEarlierEdge, witnessLaterTaken) }
  invariant EarlyTraced {
    phase != Ready => (
      errIsBadBeforeSwitch == storeIsBad(earlierStore[takenEarlierEdge])
      and (onWitness => takenEarlierEdge == witnessEarlierEdge)
    )
  }
  // After the switch, the run holds what the taken arm left, on the path
  // through the taken earlier edge.
  invariant ArmTraced {
    (phase == PastSwitch or phase == Returned) => (
      pointerIsNil == (armPointer[takenEdge] == Nil)
      and (pointerIsOutsideNil => armPointer[takenEdge] == Outside)
      and (onWitness => (takenEdge == witnessEdge and not pointerIsOutsideNil))
      and (phase == PastSwitch => errorIsBad == badAtArmEnd(takenEdge, takenEarlierEdge))
      and (phase == Returned => (
        errorIsBad == badAtLoad(takenEdge, takenEarlierEdge, laterTaken)
        and (hasLaterIf or not laterTaken)
        and (onWitness => laterTaken == witnessLaterTaken)
      ))
    )
  }

  // --- witnesses ------------------------------------------------------------------

  // `if b { u = x } else { err = e }; return u, err`: kept apart.
  reachable EdgesKeptApart {
    phase == Returned
    and not reported()
    and armPointer[0] == NonNilLiteral
    and armError[0] == NoErrorStore
    and armPointer[1] == Nil
    and armError[1] == ErrorGood
    and earlierStore[0] == NoErrorStore
    and earlierStore[1] == NoErrorStore
  }
  // The same, with an if that stores nothing before the return. It is still
  // kept apart, although the load sits in a later block.
  reachable LoadAfterJoinKeptApart {
    phase == Returned
    and not reported()
    and hasLaterIf
    and laterStore == NoErrorStore
    and laterTaken
    and armPointer[0] == NonNilLiteral
    and armError[0] == NoErrorStore
    and armPointer[1] == Nil
    and armError[1] == ErrorGood
    and earlierStore[0] == NoErrorStore
    and earlierStore[1] == NoErrorStore
  }
  // The later if stores the nil error on the edge where u is nil.
  reachable LaterStoreReported {
    phase == Returned
    and onWitness
    and witnessLaterTaken
    and laterStore == ErrorBad
    and not pathPairs(witnessEdge, witnessEarlierEdge, false)
  }
  // The earlier if stores the nil error on one arm and a non-nil one on the
  // other. So the load has two alternatives on the edge that keeps err.
  reachable EarlierStoreReported {
    phase == Returned
    and reported()
    and onWitness
    and armError[witnessEdge] == NoErrorStore
    and earlierStore[witnessEarlierEdge] == ErrorBad
    and earlierStore[1 - witnessEarlierEdge] == ErrorGood
  }
  // u from outside, nil, with the nil error: not reported. This is the gap.
  reachable OutsideNilIsMissed {
    phase == Returned and not reported() and pointerIsOutsideNil and errorIsBad
  }
  reachable ZeroThroughBoth {
    phase == Returned
    and reported()
    and onWitness
    and armError[witnessEdge] == NoErrorStore
    and earlierStore[witnessEarlierEdge] == NoErrorStore
  }
}
