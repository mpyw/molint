// Pairing a φ-node with a load: return-nil when the error is a variable SSA
// does not lift, read at the return. See "return-nil" in design/rules.md.
//
// A function literal that only loads err keeps err in memory, and keeps it
// followed. The return then pairs a φ-node u of its block with a load of err.
// pairStep in internal/flow/pair.go reads that load, along each edge into the
// block, as the stores that reach the end of that edge's predecessor: one
// alternative per store.
//
// The program:
//
//   var u *T
//   var err error                     the Alloc: a store of nil
//   defer func() { log(err) }()       only loads err
//   if a { err = P0 } else { err = P1 }   an earlier if; each arm may store
//   switch {                          three edges into the return's block;
//   case c0: u = U0; err = E0         each arm sets u, and may store err
//   case c1: u = U1; err = E1
//   default: u = U2; err = E2
//   }
//   return u, err                     u is a φ-node, err a load
//
// The stores into err are Bad (nil), Good (errors.New) or Out (f()), or
// nothing (Keep). u is nil, &T{} or f().
//
// `var u *T; var err error; defer func() { log(err) }(); if b { u = x } else
// { err = e }; return u, err` is this shape, and it is not reported: on the
// edge where u is nil, err holds e.
//
// The rule, reported below: some edge k brings the nil constant for u, and a
// store reaching the end of its predecessor stores Bad: E_k itself, or, when
// arm k stores nothing, a store reaching the switch, P0, P1 or the Alloc's
// zero.
//
// The run keeps its own record: whether u and err hold the constants.
//
// The claim:
//
//   ReportMeansNilWithBad   when reported, the witness run returns the nil
//                           constant with the nil error constant
//   NilWithBadIsReported    whenever a run returns them, it is reported
//
// ASSUME-1: branches are taken as independent, as the rule defines.
// ASSUME-2 (representation only): the trailing result is an error; a bool
//   pairs the same way (pairing.fsl, pairing_stores.fsl).
spec PairingLoad {
  enum UOp { Nil, Alloc, Ext }
  enum EOp { EKeep, EBad, EGood, EOut }
  enum Pc { Ready, Early, Returned }
  type Edge = 0..2
  type Pre = 0..1
  type Bit = 0..15

  state {
    pc: Pc,
    ch: Map<Bit, Bool>,
    // the program
    pe: Map<Pre, EOp>, uk: Map<Edge, UOp>, ek: Map<Edge, EOp>,
    // the verdict and its witness
    rep: Bool, wk: Edge, we: Pre,
    // the run's own record
    errBad: Bool, uv: Bool, uOut: Bool, eb: Bool, follow: Bool
  }

  def pickU(i: Bit) = if ch[i] then Nil else if ch[i + 1] then Alloc else Ext
  def pickE(i: Bit) =
    if ch[i] then (if ch[i + 1] then EKeep else EBad) else (if ch[i + 1] then EGood else EOut)

  // --- the rule -------------------------------------------------------------------

  // The Alloc's zero is the nil error.
  def badStore(s: EOp) = s == EBad or s == EKeep
  // The stores reaching the end of arm k's block, read on the path through
  // the earlier if's edge e.
  def reachesBad(k: Edge, e: Pre) = if ek[k] != EKeep then ek[k] == EBad else badStore(pe[e])
  def pairs(k: Edge, e: Pre) = uk[k] == Nil and reachesBad(k, e)
  def reported() = exists k: Edge { exists e: Pre { pairs(k, e) } }
  def firstEdge() =
    if exists e: Pre { pairs(0, e) } then 0 else if exists e: Pre { pairs(1, e) } then 1 else 2
  def firstPre(k: Edge) = if pairs(k, 0) then 0 else 1

  init {
    pc = Ready
    forall e: Pre { pe[e] = pickE(2 * e) }
    forall k: Edge { uk[k] = pickU(4 + 4 * k)  ek[k] = pickE(6 + 4 * k) }
    rep = reported()  wk = firstEdge()  we = firstPre(firstEdge())
    errBad = true  uv = false  uOut = false  eb = false  follow = false
  }

  // --- the run --------------------------------------------------------------------

  action early(e: Pre) {
    requires pc == Ready
    pc = Early
    errBad = if pe[e] == EKeep then errBad else pe[e] == EBad
    follow = rep and e == we
  }

  action arm(k: Edge, n: Bool) {
    requires pc == Early
    pc = Returned
    uv = uk[k] == Nil  uOut = uk[k] == Ext and n
    eb = if ek[k] == EKeep then errBad else ek[k] == EBad
    follow = follow and k == wk and not n
  }

  terminal { pc == Returned }

  // --- what is proved -------------------------------------------------------------

  invariant ReportMeansNilWithBad { (follow and pc == Returned) => (uv and eb) }
  invariant NilWithBadIsReported { (pc == Returned and uv and eb) => reported() }

  // --- auxiliary ------------------------------------------------------------------

  invariant VerdictFixed { rep == reported() and wk == firstEdge() and we == firstPre(firstEdge()) }
  invariant FreshBeforeRun { pc == Ready => (errBad and not uv and not uOut and not eb and not follow) }
  invariant FollowOnlyWhenReported { follow => rep }
  invariant WitnessWorks { rep => pairs(wk, we) }
  invariant EarlyTraced {
    pc != Ready => (exists e: Pre { errBad == badStore(pe[e]) and (follow => e == we) })
  }

  // --- witnesses ------------------------------------------------------------------

  // if b { u = x } else { err = e }; return u, err: kept apart.
  reachable EdgesKeptApart {
    pc == Returned and not reported() and uk[0] == Alloc and ek[0] == EKeep
    and uk[1] == Nil and ek[1] == EGood and pe[0] == EKeep and pe[1] == EKeep
  }
  // The earlier if stores the nil error on one arm, and a non-nil one on the
  // other: the load has two alternatives on the edge that keeps err.
  reachable EarlierStoreReported {
    pc == Returned and reported() and follow and ek[wk] == EKeep and pe[we] == EBad
    and pe[1 - we] == EGood
  }
  // u from outside, nil, with the nil error: not reported. The gap.
  reachable OutsideNilIsMissed { pc == Returned and not reported() and uOut and eb }
  reachable ZeroThroughBoth {
    pc == Returned and reported() and follow and ek[wk] == EKeep and pe[we] == EKeep
  }
}
