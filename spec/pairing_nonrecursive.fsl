// FAILS ON PURPOSE. This is the pairing rule without the recursion that
// design/rules.md now asks for, and the counterexample is the reason for it.
//
// The rule judges each edge into the return's φ-node block, but judges a
// φ-node of an earlier block whole, even when both values on the edge are
// φ-nodes of that block. The inner join then pairs a nil from one of its edges
// with a nil error from the other:
//
//   var u *T
//   var err error
//   if a {
//     if b { u = get() } else { err = errX }
//     log()                       the inner join keeps its own φ-nodes
//   } else {
//     err = errX
//   }
//   return u, err                 reported: "F returns a nil *T with a nil error"
//
// No run returns nil with a nil error. The program, the run and the claim are
// those of pairing.fsl, except for pairs() and the witness in E.
spec PairingNonRecursive {
  enum Op { Nil, Alloc, Ext, FromE }
  enum Sec { Bad, Good, Out, SFromE }
  enum Val { NilConst, NilExt, NonNil }
  enum SVal { BadConst, BadExt, GoodVal }
  enum Pc { Ready, Judged, Inner, Returned }
  type Edge = 0..2
  type Pre = 0..1
  type Bit = 0..19

  state {
    pc: Pc,
    // free choice bits that pick the program in init
    ch: Map<Bit, Bool>,
    // the program
    pu: Map<Pre, Op>, ps: Map<Pre, Sec>, u: Map<Edge, Op>, s: Map<Edge, Sec>,
    // the verdict and its witness
    rep: Bool, wk: Edge, we: Pre,
    // the run
    iu: Val, isv: SVal, ru: Val, rs: SVal, follow: Bool
  }

  def pickU(i: Bit) =
    if ch[i] then (if ch[i + 1] then Nil else Alloc) else (if ch[i + 1] then Ext else FromE)
  def pickS(i: Bit) =
    if ch[i] then (if ch[i + 1] then Bad else Good) else (if ch[i + 1] then Out else SFromE)
  // The inner join has no FromE: its operands are constants or from outside.
  def innerU(i: Bit) = if ch[i] then Nil else if ch[i + 1] then Alloc else Ext
  def innerS(i: Bit) = if ch[i] then Bad else if ch[i + 1] then Good else Out

  init {
    pc = Ready
    forall k: Edge { u[k] = pickU(4 * k)  s[k] = pickS(4 * k + 2) }
    forall e: Pre { pu[e] = innerU(12 + 4 * e)  ps[e] = innerS(14 + 4 * e) }
    rep = false  wk = 0  we = 0
    iu = NonNil  isv = GoodVal  ru = NonNil  rs = GoodVal  follow = false
  }

  // --- the rule -------------------------------------------------------------------

  def innerNil() = exists e: Pre { pu[e] == Nil }
  def innerBad() = exists e: Pre { ps[e] == Bad }
  def innerPairs(e: Pre) = pu[e] == Nil and ps[e] == Bad
  def uNil(o: Op) = o == Nil or (o == FromE and innerNil())
  def sBad(o: Sec) = o == Bad or (o == SFromE and innerBad())
  def bothFromE(k: Edge) = u[k] == FromE and s[k] == SFromE
  // THE NAIVE RULE: the φ-nodes of E are judged whole.
  def pairs(k: Edge) = uNil(u[k]) and sBad(s[k])
  def reported() = exists k: Edge { pairs(k) }

  // The witness: the edge of J the rule judged, and the edge of E it needs.
  def witnessEdge() = if pairs(0) then 0 else if pairs(1) then 1 else 2
  def witnessPre(k: Edge) =
    if u[k] == FromE then (if pu[0] == Nil then 0 else 1)
    else (if ps[0] == Bad then 0 else 1)

  action judge() {
    requires pc == Ready
    pc = Judged
    rep = reported()  wk = witnessEdge()  we = witnessPre(witnessEdge())
  }

  // --- the run --------------------------------------------------------------------

  def ev(o: Op, nilOut: Bool) =
    if o == Nil then NilConst else if o == Alloc then NonNil
    else if o == Ext then (if nilOut then NilExt else NonNil)
    else iu
  def evs(o: Sec, badOut: Bool) =
    if o == Bad then BadConst else if o == Good then GoodVal
    else if o == Out then (if badOut then BadExt else GoodVal)
    else isv

  // The run passes E even when it takes an edge of J that bypasses it. The
  // values E would hold are then never read.
  action passInner(e: Pre, nu: Bool, bs: Bool) {
    requires pc == Judged
    pc = Inner
    iu = ev(pu[e], nu)  isv = evs(ps[e], bs)
    follow = rep and e == we
  }

  action join(k: Edge, nu: Bool, bs: Bool) {
    requires pc == Inner
    pc = Returned
    ru = ev(u[k], nu)  rs = evs(s[k], bs)
    follow = follow and k == wk
  }

  terminal { pc == Returned }

  // --- what is proved -------------------------------------------------------------

  invariant ReportMeansNilWithBad {
    (follow and pc == Returned) => (ru == NilConst and rs == BadConst)
  }
  invariant NilWithBadIsReported {
    (pc == Returned and ru == NilConst and rs == BadConst) => reported()
  }

  // The auxiliary invariants of the proved spec are left out: a failing
  // spec needs no induction, and each must break on its claim.

  // --- witnesses ------------------------------------------------------------------

  // var u *T; var err error; if b { u = x } else { err = e }; return u, err
  reachable EdgesKeptApart {
    pc == Returned and not reported() and (exists k: Edge { u[k] == Nil })
    and (exists k: Edge { s[k] == Bad })
    and (forall k: Edge { u[k] != FromE and s[k] != SFromE })
  }
  // The same shape nested inside another if: the pairing continues into E.
  reachable NestedEdgesKeptApart {
    pc == Returned and not reported() and bothFromE(0) and innerNil() and innerBad()
  }
  reachable NestedPairReported {
    pc == Returned and reported() and follow and bothFromE(wk)
  }
  // One value from E, judged whole, the other a constant on the edge of J.
  reachable HalfFromEReported {
    pc == Returned and reported() and follow and u[wk] == FromE and s[wk] == Bad
  }
  reachable PairOnOuterEdge {
    pc == Returned and reported() and follow and u[wk] == Nil and s[wk] == Bad
  }
  // return nil, err: an error from outside is not a nil value.
  reachable OutsideErrorNotReported {
    pc == Returned and not reported() and ru == NilConst and rs == BadExt
  }
}
