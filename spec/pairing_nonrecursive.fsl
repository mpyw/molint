// FAILS ON PURPOSE. This is the pairing rule without the recursion into an
// earlier block, and the counterexample is the reason for it.
//
// The rule judges each edge into the return's φ-node block, but judges
// φ-nodes of an earlier block whole, even when both values on the edge are
// φ-nodes of that block. The earlier block then pairs a nil from one of its
// edges with a nil error from another:
//
//   var u *T
//   var err error
//   if a {
//     if b { u = get() } else { err = errX }
//     log()                       the inner join keeps its own φ-nodes
//   } else {
//     err = errX
//   }
//   return u, err                 reported: "F returns a nil *T with a nil error"
//
// No run returns nil with a nil error. In pairing.fsl the earlier block is the
// loop: its body join and its header.
//
// The program, the run and the claim are those of pairing.fsl, except for
// pairsOn(). The run is limited to programs that pairing.fsl's rule does not
// report, so every report here is this rule's own.
spec PairingNonRecursive {
  enum UOp { UKeep, Nil, Alloc, Ext, UFromH }
  enum SOp { SKeep, Bad, Good, Out, SFromH }
  enum Guard { NoCheck, IsNil, NotNil }
  enum Val { NilConst, NilExt, NilChecked, NonNil }
  enum SVal { BadConst, BadExt, GoodVal }
  enum Pc { Ready, Loop, Join, Returned, Aborted }
  type Edge = 0..2
  type Arm = 0..1
  // An arm, or 2: no arm.
  type Step = 0..2
  type Rounds = 0..2
  type Bit = 0..29

  state {
    pc: Pc,
    ch: Map<Bit, Bool>,
    // the program
    u0: UOp, s0: SOp, bu: Map<Arm, UOp>, bs: Map<Arm, SOp>,
    ju: Map<Edge, UOp>, js: Map<Edge, SOp>, jg: Map<Edge, Guard>,
    // the verdict and its witness
    rep: Bool, wk: Edge, wx: Step, wy: Step, wnil: Bool,
    // the run: the values, and which store each came from
    hu: Val, hs: SVal, uSrc: Step, sSrc: Step, uLater: Bool, lastArm: Step,
    rounds: Rounds, taken: Edge, ru: Val, rs: SVal, follow: Bool
  }

  def pickEntryU(i: Bit) = if ch[i] then Nil else if ch[i + 1] then Alloc else Ext
  def pickEntryS(i: Bit) = if ch[i] then Bad else if ch[i + 1] then Good else Out
  def pickArmU(i: Bit) =
    if ch[i] then (if ch[i + 1] then UKeep else Nil) else (if ch[i + 1] then Alloc else Ext)
  def pickArmS(i: Bit) =
    if ch[i] then (if ch[i + 1] then SKeep else Bad) else (if ch[i + 1] then Good else Out)
  def pickJoinU(i: Bit) =
    if ch[i] then (if ch[i + 1] then Nil else Alloc) else (if ch[i + 1] then Ext else UFromH)
  def pickJoinS(i: Bit) =
    if ch[i] then (if ch[i + 1] then Bad else Good) else (if ch[i + 1] then Out else SFromH)
  def pickGuard(i: Bit) = if ch[i] then NoCheck else if ch[i + 1] then IsNil else NotNil

  // --- the rule -------------------------------------------------------------------

  // The last value set on the path x, then y.
  def finU(x: Step, y: Step) =
    if y != 2 and bu[y] != UKeep then bu[y] else if x != 2 and bu[x] != UKeep then bu[x] else u0
  def finS(x: Step, y: Step) =
    if y != 2 and bs[y] != SKeep then bs[y] else if x != 2 and bs[x] != SKeep then bs[x] else s0
  def path(x: Step, y: Step) = x == 2 => y == 2
  def uAt(k: Edge, x: Step, y: Step) = if ju[k] == UFromH then finU(x, y) else ju[k]
  def sAt(k: Edge, x: Step, y: Step) = if js[k] == SFromH then finS(x, y) else js[k]
  def uNilAt(k: Edge, x: Step, y: Step) =
    if jg[k] == IsNil then (uAt(k, x, y) == Nil or uAt(k, x, y) == Ext)
    else jg[k] == NoCheck and uAt(k, x, y) == Nil
  def pairs(k: Edge, x: Step, y: Step) =
    path(x, y) and uNilAt(k, x, y) and sAt(k, x, y) == Bad
  // THE NAIVE RULE: the values from the loop are judged whole.
  def uOk(k: Edge) = exists x: Step { exists y: Step { path(x, y) and uNilAt(k, x, y) } }
  def sOk(k: Edge) = exists x: Step { exists y: Step { path(x, y) and sAt(k, x, y) == Bad } }
  def pairsOn(k: Edge) = uOk(k) and sOk(k)
  // The rule of pairing.fsl, to pick the programs it does not report.
  def provedReported() = exists k: Edge { exists x: Step { exists y: Step { pairs(k, x, y) } } }
  def reported() = exists k: Edge { pairsOn(k) }

  // The witness: the first edge and path the rule found.
  def firstEdge() = if pairsOn(0) then 0 else if pairsOn(1) then 1 else 2
  // The witness runs the path that makes the error Bad.
  def sPath(k: Edge, x: Step, y: Step) = path(x, y) and sAt(k, x, y) == Bad
  def firstX(k: Edge) =
    if exists y: Step { sPath(k, 0, y) } then 0 else if exists y: Step { sPath(k, 1, y) } then 1 else 2
  def firstY(k: Edge, x: Step) = if sPath(k, x, 0) then 0 else if sPath(k, x, 1) then 1 else 2
  def len(x: Step, y: Step) = (if x != 2 then 1 else 0) + (if y != 2 then 1 else 0)

  // --- ASSUME-2: every check can succeed and fail ---------------------------------

  def mayNilU(o: UOp) = o == Nil or o == Ext
  def mayNonNilU(o: UOp) = o == Alloc or o == Ext
  def loopMay(nilSide: Bool) =
    (if nilSide then mayNilU(u0) else mayNonNilU(u0))
    or (exists j: Arm { if nilSide then mayNilU(bu[j]) else mayNonNilU(bu[j]) })
  def live(k: Edge) =
    (jg[k] == IsNil => (if ju[k] == UFromH then loopMay(true) else mayNilU(ju[k])))
    and (jg[k] == NotNil => (if ju[k] == UFromH then loopMay(false) else mayNonNilU(ju[k])))
  def configOk() = forall k: Edge { live(k) }

  init {
    pc = Ready
    u0 = pickEntryU(0)  s0 = pickEntryS(2)
    forall j: Arm { bu[j] = pickArmU(4 + 4 * j)  bs[j] = pickArmS(6 + 4 * j) }
    forall k: Edge { ju[k] = pickJoinU(12 + 6 * k)  js[k] = pickJoinS(14 + 6 * k)  jg[k] = pickGuard(16 + 6 * k) }
    // The verdict and the witness read only the program set above.
    rep = reported()  wk = firstEdge()  wx = firstX(firstEdge())
    wy = firstY(firstEdge(), firstX(firstEdge()))  wnil = jg[firstEdge()] == IsNil
    hu = NonNil  hs = GoodVal  uSrc = 2  sSrc = 2  uLater = false  lastArm = 2
    rounds = 0  taken = 0  ru = NonNil  rs = GoodVal  follow = false
  }

  // --- the run --------------------------------------------------------------------

  def ev(o: UOp, nilOut: Bool, old: Val) =
    if o == Nil then NilConst else if o == Alloc then NonNil
    else if o == Ext then (if nilOut then NilExt else NonNil) else old
  def evs(o: SOp, badOut: Bool, old: SVal) =
    if o == Bad then BadConst else if o == Good then GoodVal
    else if o == Out then (if badOut then BadExt else GoodVal) else old
  def passes(c: Guard, v: Val) =
    if c == IsNil then v != NonNil else if c == NotNil then v == NonNil else true
  def mark(c: Guard, v: Val) = if c == IsNil and v == NilExt then NilChecked else v
  def goodNil(v: Val) = v == NilConst or v == NilChecked

  action enter(nu: Bool, bsOut: Bool) {
    requires pc == Ready  requires configOk()  requires not provedReported()
    pc = Loop
    hu = ev(u0, nu, NonNil)  hs = evs(s0, bsOut, GoodVal)
    follow = rep and nu == wnil and not bsOut
  }

  action round(j: Arm, nu: Bool, bsOut: Bool) {
    requires pc == Loop
    hu = ev(bu[j], nu, hu)  hs = evs(bs[j], bsOut, hs)
    uSrc = if bu[j] != UKeep then j else uSrc
    sSrc = if bs[j] != SKeep then j else sSrc
    uLater = if bu[j] != UKeep and bs[j] == SKeep then true
             else if bs[j] != SKeep then false else uLater
    lastArm = j
    rounds = min(rounds + 1, 2)
    follow = follow and rounds < len(wx, wy) and (if rounds == 0 then j == wx else j == wy)
             and nu == wnil and not bsOut
  }

  action leave() {
    requires pc == Loop
    pc = Join
    follow = follow and rounds == len(wx, wy)
  }

  def uOn(k: Edge, nu: Bool) = if ju[k] == UFromH then hu else ev(ju[k], nu, NonNil)
  def sOn(k: Edge, bsOut: Bool) = if js[k] == SFromH then hs else evs(js[k], bsOut, GoodVal)

  action take(k: Edge, nu: Bool, bsOut: Bool) {
    requires pc == Join  requires passes(jg[k], uOn(k, nu))
    pc = Returned  taken = k
    ru = mark(jg[k], uOn(k, nu))  rs = sOn(k, bsOut)
    follow = follow and k == wk and nu == wnil and not bsOut
  }

  action abort() {
    requires pc == Join
    pc = Aborted  follow = false
  }

  terminal { pc == Returned or pc == Aborted or (pc == Ready and not configOk()) }

  // --- what is proved -------------------------------------------------------------

  // Never blocked: the witness's edge passes its check, and it returns the pair.
  invariant ReportMeansNilWithBad {
    (follow and pc == Join => passes(jg[wk], uOn(wk, wnil)))
    and (follow and pc == Returned => (goodNil(ru) and rs == BadConst))
  }
  invariant NilWithBadIsReported {
    (pc == Returned and goodNil(ru) and rs == BadConst) => reported()
  }

  // The auxiliary invariants of the proved spec are left out: a failing
  // spec needs no induction, and each must break on its claim.

  // --- witnesses ------------------------------------------------------------------

  // var u *T; var err error; if b { u = x } else { err = e }; return u, err
  // (one round of the loop, then the edge that brings both from H).
  reachable EdgesKeptApart {
    pc == Returned and not reported() and u0 == Nil and s0 == Bad
    and bu[0] == Alloc and bs[0] == SKeep and bu[1] == UKeep and bs[1] == Good
    and ju[taken] == UFromH and js[taken] == SFromH and rounds == 1
  }
  // A nil set in one round, a nil error in the next: reported.
  reachable PairAcrossRounds {
    pc == Returned and follow and len(wx, wy) == 2 and ju[wk] == UFromH and js[wk] == SFromH
    and not pairs(wk, wx, 2) and not pairs(wk, wy, 2)
  }
  // if u != nil { return u, s }: the check settles u before H is taken apart.
  reachable CheckStopsThePair {
    pc == Returned and not reported() and jg[taken] == NotNil and ju[taken] == UFromH
    and js[taken] == SFromH and (exists x: Step { exists y: Step { path(x, y)
      and finU(x, y) == Nil and finS(x, y) == Bad } })
  }
  // u := f(); if u == nil { return u, nil }: a value from before J, checked
  // on the edge.
  reachable CheckedOutsideWithBad {
    pc == Returned and follow and jg[wk] == IsNil and ju[wk] == Ext and ru == NilChecked
  }
  reachable CheckedLoopValueWithBad {
    pc == Returned and follow and jg[wk] == IsNil and ju[wk] == UFromH and ru == NilChecked
  }
  // return nil, err with err from outside: not reported. The gap.
  reachable OutsideErrorNotReported {
    pc == Returned and not reported() and ru == NilConst and rs == BadExt
  }
  // return u, nil with u from outside, unchecked: not reported. The gap.
  reachable OutsideNilNotReported {
    pc == Returned and not reported() and ru == NilExt and rs == BadConst
  }
}
