// FAILS ON PURPOSE. This is the nil-value rule that ignores nil checks on
// the way. Its counterexample is the reason each edge is judged at its own
// check.
//
// An edge under a check that the value is not nil still counts as bringing
// nil when its operand is a nil value:
//
//   var p *T
//   if c { p = x }              p is φ(nil, x)
//   if p == nil { p = def }
//   return p                    reported: "F returns a nil *T"
//
// The edge that keeps p runs only when p is not nil. The witness run takes
// that edge, and the edge's check blocks it.
//
// The program, the run and the claim are those of nil_value.fsl, except for
// edgeBringsNil. The run is also limited to programs that nil_value.fsl's
// rule does not report. So every report here is this rule's own. Every
// check can pass on some run (ASSUME-2 of nil_value.fsl).
fsl 5
spec NilValueNoCheck {
  // Nil is the constant. NonNilLiteral is &T{}. Outside is f().
  enum Operand { Nil, NonNilLiteral, Outside, PhiA, PhiB }
  enum Check { NoCheck, IsNil, NotNil }
  enum Value { NilConstant, NilOutside, NilChecked, NonNil }
  enum Phase { Ready, InLoop, AtJoin, Returned, Aborted }
  type Edge = 0..2
  type RoundCount = 0..4
  type ChoiceBit = 0..28
  // A slot of the forward runs. Slots 0 to 3 have every f() non-nil, and 4
  // to 7 have every f() nil. Each slot is the run after 0 to 3 rounds.
  type ForwardSlot = 0..7

  state {
    phase: Phase,
    // free choice bits that pick the program in init
    choice: Map<ChoiceBit, Bool>,
    // the program
    entryA: Operand,
    entryB: Operand,
    backA: Operand,
    backB: Operand,
    checkA: Check,
    checkB: Check,
    joinOperand: Map<Edge, Operand>,
    joinCheck: Map<Edge, Check>,
    // the run
    valueA: Value,
    valueB: Value,
    rounds: RoundCount,
    returnedValue: Value,
    takenEdge: Edge,
    // the forward runs the witness is chosen from, fixed with the program
    forwardA: Map<ForwardSlot, Value>,
    forwardB: Map<ForwardSlot, Value>,
    // the rule's verdict and its witness, fixed with the program
    verdict: Bool,
    witnessEdge: Edge,
    witnessOutsideNil: Bool,
    witnessRounds: RoundCount,
    // the run has made the witness's choices so far
    onWitness: Bool
  }

  // An entry operand: nil, &T{} or f().
  def pickEntryOperand(bit: ChoiceBit) =
    if choice[bit] then Nil
    else if choice[bit + 1] then NonNilLiteral
    else Outside
  // Any operand.
  def pickOperand(bit: ChoiceBit) =
    if choice[bit] then
      if choice[bit + 1] then Nil
      else NonNilLiteral
    else if choice[bit + 1] then
      if choice[bit + 2] then Outside
      else PhiA
    else PhiB
  def pickCheck(bit: ChoiceBit) =
    if choice[bit] then NoCheck
    else if choice[bit + 1] then IsNil
    else NotNil

  // init chooses the program from free choice bits. So every program is a
  // start, and nothing changes it afterwards.
  init {
    phase = Ready
    entryA = pickEntryOperand(0)
    entryB = pickEntryOperand(2)
    backA = pickOperand(4)
    backB = pickOperand(7)
    checkA = pickCheck(10)
    checkB = pickCheck(12)
    forall edge: Edge {
      joinOperand[edge] = pickOperand(14 + 3 * edge)
      joinCheck[edge] = pickCheck(23 + 2 * edge)
    }
    valueA = NonNil
    valueB = NonNil
    rounds = 0
    returnedValue = NonNil
    takenEdge = 0
    // The forward runs come first, then the verdict and the witness. init
    // assigns in order, so the verdict and the witness read the runs above
    // them. The verdict reads only the program.
    forwardA[0] = runA0(false)
    forwardB[0] = runB0(false)
    forwardA[4] = runA0(true)
    forwardB[4] = runB0(true)
    forwardA[1] = runA1(false)
    forwardB[1] = runB1(false)
    forwardA[5] = runA1(true)
    forwardB[5] = runB1(true)
    forwardA[2] = runA2(false)
    forwardB[2] = runB2(false)
    forwardA[6] = runA2(true)
    forwardB[6] = runB2(true)
    forwardA[3] = runA3(false)
    forwardB[3] = runB3(false)
    forwardA[7] = runA3(true)
    forwardB[7] = runB3(true)
    verdict = reported()
    witnessEdge = chooseWitnessEdge()
    witnessOutsideNil = chooseWitnessOutsideNil()
    witnessRounds = chooseWitnessRounds()
    onWitness = false
  }

  // --- the rule: a pure function of the program ---------------------------------

  def isNilConstant(operand: Operand) = operand == Nil
  // An edge of a loop φ-node that brings a nil without going through the
  // other loop φ-node.
  def aNilWithoutB() =
    isNilConstant(entryA)
    or checkA == IsNil
    or (checkA == NoCheck and isNilConstant(backA))
  def bNilWithoutA() =
    isNilConstant(entryB)
    or checkB == IsNil
    or (checkB == NoCheck and isNilConstant(backB))
  def aIsNilValue() = aNilWithoutB() or (checkA == NoCheck and backA == PhiB and bNilWithoutA())
  def bIsNilValue() = bNilWithoutA() or (checkB == NoCheck and backB == PhiA and aNilWithoutB())
  def isNilValue(operand: Operand) =
    isNilConstant(operand)
    or (operand == PhiA and aIsNilValue())
    or (operand == PhiB and bIsNilValue())
  // THE NAIVE RULE: a check on the way does not stop a nil.
  def edgeBringsNil(edge: Edge) = joinCheck[edge] == IsNil or isNilValue(joinOperand[edge])
  // The rule of nil_value.fsl, to pick the programs it does not report.
  def provedReported() =
    exists edge: Edge {
      joinCheck[edge] == IsNil
      or (joinCheck[edge] == NoCheck and isNilValue(joinOperand[edge]))
    }
  def reported() = exists edge: Edge { edgeBringsNil(edge) }

  // --- ASSUME-2: what may be nil, or non-nil, on some run -------------------------

  def mayBeNil(operand: Operand) = operand == Nil or operand == Outside
  def mayBeNonNil(operand: Operand) = operand == NonNilLiteral or operand == Outside
  def aMayBeNil() =
    mayBeNil(entryA)
    or (checkA != NotNil and (
      mayBeNil(backA)
      or (backA == PhiB and (mayBeNil(entryB) or (checkB != NotNil and mayBeNil(backB))))
    ))
  def bMayBeNil() =
    mayBeNil(entryB)
    or (checkB != NotNil and (
      mayBeNil(backB)
      or (backB == PhiA and (mayBeNil(entryA) or (checkA != NotNil and mayBeNil(backA))))
    ))
  def aMayBeNonNil() =
    mayBeNonNil(entryA)
    or (checkA != IsNil and (
      mayBeNonNil(backA)
      or (backA == PhiB and (mayBeNonNil(entryB) or (checkB != IsNil and mayBeNonNil(backB))))
    ))
  def bMayBeNonNil() =
    mayBeNonNil(entryB)
    or (checkB != IsNil and (
      mayBeNonNil(backB)
      or (backB == PhiA and (mayBeNonNil(entryA) or (checkA != IsNil and mayBeNonNil(backA))))
    ))
  def operandMayBeNil(operand: Operand) =
    mayBeNil(operand)
    or (operand == PhiA and aMayBeNil())
    or (operand == PhiB and bMayBeNil())
  def operandMayBeNonNil(operand: Operand) =
    mayBeNonNil(operand)
    or (operand == PhiA and aMayBeNonNil())
    or (operand == PhiB and bMayBeNonNil())
  def checkCanPass(check: Check, operand: Operand) =
    (check == IsNil => operandMayBeNil(operand))
    and (check == NotNil => operandMayBeNonNil(operand))
  def entryOperandsValid() =
    (entryA == Nil or entryA == NonNilLiteral or entryA == Outside)
    and (entryB == Nil or entryB == NonNilLiteral or entryB == Outside)
  def everyCheckCanPass() =
    checkCanPass(checkA, backA)
    and checkCanPass(checkB, backB)
    and (forall edge: Edge { checkCanPass(joinCheck[edge], joinOperand[edge]) })

  // --- the run's semantics --------------------------------------------------------

  // What an operand gives, with valueOfA and valueOfB the values of a and b.
  def operandValue(operand: Operand, outsideIsNil: Bool, valueOfA: Value, valueOfB: Value) =
    if operand == Nil then NilConstant
    else if operand == NonNilLiteral then NonNil
    else if operand == Outside then
      if outsideIsNil then NilOutside
      else NonNil
    else if operand == PhiA then valueOfA
    else valueOfB
  def passesCheck(check: Check, value: Value) =
    if check == IsNil then value != NonNil
    else if check == NotNil then value == NonNil
    else true
  // A nil from outside that passes x == nil is recorded as checked.
  def afterCheck(check: Check, value: Value) =
    if check == IsNil and value == NilOutside then NilChecked else value
  // One round's update of a loop φ-node: it takes the new value if that
  // value passes the check.
  def afterRound(check: Check, value: Value, old: Value) =
    if passesCheck(check, value) then afterCheck(check, value) else old
  def reportableNil(value: Value) = value == NilConstant or value == NilChecked

  // --- the witness, found by running forward under each choice ------------------

  // init computes the forward runs a round at a time.
  def forwardSlot(outsideNil: Bool, roundCount: RoundCount) =
    (if outsideNil then 4 else 0) + roundCount
  def forwardStepA(outsideNil: Bool, roundCount: RoundCount) =
    afterRound(
      checkA,
      operandValue(
        backA,
        outsideNil,
        forwardA[forwardSlot(outsideNil, roundCount)],
        forwardB[forwardSlot(outsideNil, roundCount)]),
      forwardA[forwardSlot(outsideNil, roundCount)])
  def forwardStepB(outsideNil: Bool, roundCount: RoundCount) =
    afterRound(
      checkB,
      operandValue(
        backB,
        outsideNil,
        forwardA[forwardSlot(outsideNil, roundCount)],
        forwardB[forwardSlot(outsideNil, roundCount)]),
      forwardB[forwardSlot(outsideNil, roundCount)])
  // The same run, from the values of a and b before a round. The init
  // block uses these. It cannot read forwardA or forwardB while it still
  // assigns them.
  def nextRoundA(outsideNil: Bool, valueOfA: Value, valueOfB: Value) =
    afterRound(checkA, operandValue(backA, outsideNil, valueOfA, valueOfB), valueOfA)
  def nextRoundB(outsideNil: Bool, valueOfA: Value, valueOfB: Value) =
    afterRound(checkB, operandValue(backB, outsideNil, valueOfA, valueOfB), valueOfB)
  def runA0(outsideNil: Bool) = operandValue(entryA, outsideNil, NonNil, NonNil)
  def runB0(outsideNil: Bool) = operandValue(entryB, outsideNil, NonNil, NonNil)
  def runA1(outsideNil: Bool) = nextRoundA(outsideNil, runA0(outsideNil), runB0(outsideNil))
  def runB1(outsideNil: Bool) = nextRoundB(outsideNil, runA0(outsideNil), runB0(outsideNil))
  def runA2(outsideNil: Bool) = nextRoundA(outsideNil, runA1(outsideNil), runB1(outsideNil))
  def runB2(outsideNil: Bool) = nextRoundB(outsideNil, runA1(outsideNil), runB1(outsideNil))
  def runA3(outsideNil: Bool) = nextRoundA(outsideNil, runA2(outsideNil), runB2(outsideNil))
  def runB3(outsideNil: Bool) = nextRoundB(outsideNil, runA2(outsideNil), runB2(outsideNil))

  def forwardJoinValue(edge: Edge, outsideNil: Bool, roundCount: RoundCount) =
    operandValue(
      joinOperand[edge],
      outsideNil,
      forwardA[forwardSlot(outsideNil, roundCount)],
      forwardB[forwardSlot(outsideNil, roundCount)])
  def witnessWorksAt(edge: Edge, outsideNil: Bool, roundCount: RoundCount) =
    passesCheck(joinCheck[edge], forwardJoinValue(edge, outsideNil, roundCount))
    and reportableNil(afterCheck(joinCheck[edge], forwardJoinValue(edge, outsideNil, roundCount)))

  def chooseWitnessEdge() =
    if edgeBringsNil(0) then 0
    else if edgeBringsNil(1) then 1
    else 2
  def chooseWitnessOutsideNil() =
    not (exists roundCount: RoundCount {
      roundCount <= 3 and witnessWorksAt(chooseWitnessEdge(), false, roundCount)
    })
  def chooseWitnessRounds() =
    if witnessWorksAt(chooseWitnessEdge(), chooseWitnessOutsideNil(), 0) then 0
    else if witnessWorksAt(chooseWitnessEdge(), chooseWitnessOutsideNil(), 1) then 1
    else if witnessWorksAt(chooseWitnessEdge(), chooseWitnessOutsideNil(), 2) then 2
    else 3

  // --- the run --------------------------------------------------------------------

  action enter(outsideNilA: Bool, outsideNilB: Bool) {
    requires phase == Ready
    requires everyCheckCanPass()
    requires not provedReported()
    phase = InLoop
    valueA = operandValue(entryA, outsideNilA, valueA, valueB)
    valueB = operandValue(entryB, outsideNilB, valueA, valueB)
    onWitness = verdict
                and outsideNilA == witnessOutsideNil
                and outsideNilB == witnessOutsideNil
  }

  action round(outsideNilA: Bool, outsideNilB: Bool) {
    requires phase == InLoop
    valueA = afterRound(checkA, operandValue(backA, outsideNilA, valueA, valueB), valueA)
    valueB = afterRound(checkB, operandValue(backB, outsideNilB, valueA, valueB), valueB)
    rounds = min(rounds + 1, 4)
    onWitness = onWitness
                and rounds < witnessRounds
                and outsideNilA == witnessOutsideNil
                and outsideNilB == witnessOutsideNil
  }

  action exit() {
    requires phase == InLoop
    phase = AtJoin
    onWitness = onWitness and rounds == witnessRounds
  }

  action take(edge: Edge, outsideNil: Bool) {
    requires phase == AtJoin
    requires passesCheck(joinCheck[edge], operandValue(joinOperand[edge], outsideNil, valueA, valueB))
    phase = Returned
    takenEdge = edge
    returnedValue = afterCheck(joinCheck[edge], operandValue(joinOperand[edge], outsideNil, valueA, valueB))
    onWitness = onWitness and edge == witnessEdge and outsideNil == witnessOutsideNil
  }

  // No edge may pass its check. The function then panics or never returns.
  action abort() {
    requires phase == AtJoin
    phase = Aborted
    onWitness = false
  }

  // A program outside ASSUME-2 never runs.
  terminal {
    phase == Returned
    or phase == Aborted
    or (phase == Ready and not everyCheckCanPass())
  }

  // --- what is proved -------------------------------------------------------------

  invariant ReportMeansANilIsReturned {
    (onWitness and phase == AtJoin =>
      passesCheck(
        joinCheck[witnessEdge],
        operandValue(joinOperand[witnessEdge], witnessOutsideNil, valueA, valueB)))
    and (onWitness and phase == Returned => reportableNil(returnedValue))
  }
  invariant CheckedOrConstantNilIsReported {
    (phase == Returned and reportableNil(returnedValue)) => reported()
  }
  invariant CheckedEdgeIsReported {
    (phase == Returned and joinCheck[takenEdge] == IsNil) => reported()
  }

  // The auxiliary invariants of the proved spec are left out. A failing
  // spec needs no induction, and each spec must break on its claim.

  // --- witnesses ------------------------------------------------------------------

  // a, b = b, nil: the nil reaches a on the second round.
  reachable NilAfterTwoRounds {
    phase == Returned
    and returnedValue == NilConstant
    and joinOperand[takenEdge] == PhiA
    and backA == PhiB
    and backB == Nil
    and checkA == NoCheck
    and checkB == NoCheck
    and entryA == NonNilLiteral
    and entryB == NonNilLiteral
    and rounds == 2
  }
  // `if p == nil { p = def }; return p`, where p may be nil.
  reachable CheckStopsTheNil {
    phase == Returned
    and not reported()
    and aIsNilValue()
    and joinOperand[0] == PhiA
    and joinCheck[0] == NotNil
    and joinOperand[1] == NonNilLiteral
    and joinCheck[1] == NoCheck
    and joinOperand[2] == NonNilLiteral
  }
  // `for ... { if x := f(); x == nil { a = x } }`: a nil checked on a loop
  // edge.
  reachable CheckedOnALoopEdge {
    phase == Returned
    and onWitness
    and checkA == IsNil
    and backA == Outside
    and joinOperand[takenEdge] == PhiA
    and joinCheck[takenEdge] == NoCheck
    and returnedValue == NilChecked
  }
  // `for ... { if b != nil { a = b }; b = &T{} }`, with b nil on entry.
  // The check on a's loop edge stops the nil that b brings.
  reachable LoopCheckStopsTheEdge {
    phase == Returned
    and not reported()
    and checkA == NotNil
    and backA == PhiB
    and entryA == NonNilLiteral
    and entryB == Nil
    and backB == NonNilLiteral
    and bIsNilValue()
    and joinOperand[0] == PhiA
    and joinCheck[0] == NoCheck
  }
  reachable CheckedOutsideNilReported {
    phase == Returned
    and reported()
    and joinOperand[takenEdge] == Outside
    and joinCheck[takenEdge] == IsNil
    and returnedValue == NilChecked
  }
  reachable CheckedPhiNilReported {
    phase == Returned
    and reported()
    and joinOperand[takenEdge] == PhiB
    and joinCheck[takenEdge] == IsNil
    and not bIsNilValue()
    and returnedValue == NilChecked
  }
  reachable ExtNilIsNotReported {
    phase == Returned and returnedValue == NilOutside and not reported()
  }
  // The witness runs to the return: round the loop twice, three times, and
  // through a check.
  reachable WitnessTakesTwoRounds { onWitness and phase == Returned and witnessRounds == 2 }
  reachable WitnessTakesThreeRounds { onWitness and phase == Returned and witnessRounds == 3 }
  reachable WitnessThroughACheck {
    onWitness
    and phase == Returned
    and witnessOutsideNil
    and joinOperand[witnessEdge] == PhiA
  }
  // A report says that some run returns nil, not that this one does.
  reachable ReportedRunReturnsNonNil {
    phase == Returned and reported() and returnedValue == NonNil
  }
}
