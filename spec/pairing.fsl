// When return-nil reports a nil pointer that comes with a trailing error or
// bool, through φ-nodes. See "return-nil" in design/rules.md.
//
// A nil pointer with a trailing error is reported only when the error is
// also a nil value. With a trailing bool, it is reported only when the bool
// is the constant true. Both rules pair two results in the same way, so
// this spec models them once. The second result, s, is one of:
//
//   Bad   the nil error (constant nil), or the constant true
//   Good  a non-nil error (errors.New), or the constant false
//   Out   a value from outside: a call's result or a parameter
//
// The program:
//
//   u, s := U0, S0                    entry: nil, &T{}, f() / Bad, Good, Out
//   for cond() {                      loop header H: two φ-nodes
//     if b { u, s = X0, Y0 }          body join B, two arms. Each arm sets u,
//     else { u, s = X1, Y1 }          s, both, or neither
//   }
//   switch {                          the return's join J, three edges
//   case c0: [check] u, s = U0', S0'  each operand is a constant, f(), or
//   case c1: [check] ...              what the loop left (FromLoop). Each
//   default: [check] ...              edge may check its u: u == nil, or
//   }                                 u != nil
//   return u, s
//
// In the state, U0 and S0 are entryPointer and entrySecond. X and Y are
// armPointer and armSecond. The operands on J's edges are joinPointer and
// joinSecond, and their checks are joinCheck.
//
// The rule, from design/rules.md, judges a return along each edge into the
// φ-node block. When the values on an edge are φ-nodes of the same earlier
// block, the rule does the same there, along one edge of that block. It
// recurses. Through H and B, that is a path of rounds. The pair read along
// it is the last X and the last Y the path set, or U0 and S0. A value from
// outside is not a nil value. A check on the edge settles u for the whole
// path. A check `u != nil` stops the edge before its φ-nodes are taken
// apart. A check `u == nil` makes u a nil value on every path where u can
// be nil.
//
// pair() in internal/flow/pair.go does the recursion. It keeps a set of the
// pairs it has seen, so that the loop ends. A path of at most two rounds
// gives every pair that a longer path gives. It takes the round of one
// result's last store, then the round of the other's. So the rule below
// looks at those paths only.
//
// The run keeps its own record of each value. The rule never reads it.
//
// The claim: the rule reports exactly when some run returns a nil pointer
// that is a constant's or that passed a nil check, with a Bad constant.
//
//   ReportMeansNilWithBad   when reported, the witness run is never
//                           blocked, and it returns such a pair
//   NilWithBadIsReported    whenever a run returns such a pair, it is
//                           reported
//
// init chooses the program from free choice bits. It also fixes the verdict
// and the witness, which read only the program.
//
// ASSUME-1: branches are taken as independent, as the rule defines. The gap
//   when they correlate is nil_value_correlated.fsl.
// ASSUME-2: every check can pass on some run, as in nil_value.fsl. The gap
//   is nil_value_dead_check.fsl.
// ASSUME-3: u and s are φ-nodes, not loads of result variables. A bare
//   return in a function with a defer loads them: pairing_stores.fsl. A φ
//   paired with a load is pairing_load.fsl.
// ASSUME-4 (representation only): two arms in the loop and three edges into
//   J. The loop gives the recursion into an earlier block. It also gives a
//   pair whose two values come from different rounds.
fsl 5
spec Pairing {
  // KeepsPointer and KeepsSecond: the arm leaves that result as it was.
  // NonNilLiteral is &T{}. Outside and SecondOutside are f(). The FromLoop
  // operands are what the loop left in u or s.
  enum PointerOperand { KeepsPointer, Nil, NonNilLiteral, Outside, PointerFromLoop }
  enum SecondOperand { KeepsSecond, Bad, Good, SecondOutside, SecondFromLoop }
  enum Check { NoCheck, IsNil, NotNil }
  enum Value { NilConstant, NilOutside, NilChecked, NonNil }
  enum SecondValue { BadConstant, BadOutside, GoodValue }
  enum Phase { Ready, InLoop, AtJoin, Returned, Aborted }
  type Edge = 0..2
  type Arm = 0..1
  // An arm, or 2 for no arm.
  type ArmOrNone = 0..2
  type Rounds = 0..2
  type ChoiceBit = 0..29

  state {
    phase: Phase,
    choice: Map<ChoiceBit, Bool>,
    // the program
    entryPointer: PointerOperand,
    entrySecond: SecondOperand,
    armPointer: Map<Arm, PointerOperand>,
    armSecond: Map<Arm, SecondOperand>,
    joinPointer: Map<Edge, PointerOperand>,
    joinSecond: Map<Edge, SecondOperand>,
    joinCheck: Map<Edge, Check>,
    // the verdict and its witness
    verdict: Bool,
    witnessEdge: Edge,
    witnessFirstArm: ArmOrNone,
    witnessLaterArm: ArmOrNone,
    witnessOutsideNil: Bool,
    // the run: the values, and which arm's store each came from
    loopPointer: Value,
    loopSecond: SecondValue,
    pointerArm: ArmOrNone,
    secondArm: ArmOrNone,
    pointerStoredLater: Bool,
    lastArm: ArmOrNone,
    rounds: Rounds,
    takenEdge: Edge,
    returnedPointer: Value,
    returnedSecond: SecondValue,
    onWitness: Bool
  }

  def pickEntryPointer(bit: ChoiceBit) =
    if choice[bit] then Nil else if choice[bit + 1] then NonNilLiteral else Outside
  def pickEntrySecond(bit: ChoiceBit) =
    if choice[bit] then Bad else if choice[bit + 1] then Good else SecondOutside
  def pickArmPointer(bit: ChoiceBit) =
    if choice[bit] then (if choice[bit + 1] then KeepsPointer else Nil)
    else (if choice[bit + 1] then NonNilLiteral else Outside)
  def pickArmSecond(bit: ChoiceBit) =
    if choice[bit] then (if choice[bit + 1] then KeepsSecond else Bad)
    else (if choice[bit + 1] then Good else SecondOutside)
  def pickJoinPointer(bit: ChoiceBit) =
    if choice[bit] then (if choice[bit + 1] then Nil else NonNilLiteral)
    else (if choice[bit + 1] then Outside else PointerFromLoop)
  def pickJoinSecond(bit: ChoiceBit) =
    if choice[bit] then (if choice[bit + 1] then Bad else Good)
    else (if choice[bit + 1] then SecondOutside else SecondFromLoop)
  def pickCheck(bit: ChoiceBit) =
    if choice[bit] then NoCheck else if choice[bit + 1] then IsNil else NotNil

  // --- the rule -------------------------------------------------------------------

  // The last value set on the path: the arm first, then the arm later.
  def lastPointer(first: ArmOrNone, later: ArmOrNone) =
    if later != 2 and armPointer[later] != KeepsPointer then armPointer[later]
    else if first != 2 and armPointer[first] != KeepsPointer then armPointer[first]
    else entryPointer
  def lastSecond(first: ArmOrNone, later: ArmOrNone) =
    if later != 2 and armSecond[later] != KeepsSecond then armSecond[later]
    else if first != 2 and armSecond[first] != KeepsSecond then armSecond[first]
    else entrySecond
  def isPath(first: ArmOrNone, later: ArmOrNone) = first == 2 => later == 2
  def pointerOnEdge(edge: Edge, first: ArmOrNone, later: ArmOrNone) =
    if joinPointer[edge] == PointerFromLoop then lastPointer(first, later) else joinPointer[edge]
  def secondOnEdge(edge: Edge, first: ArmOrNone, later: ArmOrNone) =
    if joinSecond[edge] == SecondFromLoop then lastSecond(first, later) else joinSecond[edge]
  def pointerNilOnEdge(edge: Edge, first: ArmOrNone, later: ArmOrNone) =
    if joinCheck[edge] == IsNil then (
      pointerOnEdge(edge, first, later) == Nil
      or pointerOnEdge(edge, first, later) == Outside
    )
    else joinCheck[edge] == NoCheck and pointerOnEdge(edge, first, later) == Nil
  def pairs(edge: Edge, first: ArmOrNone, later: ArmOrNone) =
    isPath(first, later)
    and pointerNilOnEdge(edge, first, later)
    and secondOnEdge(edge, first, later) == Bad
  def pairsOnEdge(edge: Edge) =
    exists first: ArmOrNone { exists later: ArmOrNone { pairs(edge, first, later) } }
  def reported() = exists edge: Edge { pairsOnEdge(edge) }

  // The witness: the first edge and path that the rule found.
  def firstEdge() = if pairsOnEdge(0) then 0 else if pairsOnEdge(1) then 1 else 2
  def firstArmOfPath(edge: Edge) =
    if exists later: ArmOrNone { pairs(edge, 0, later) } then 0
    else if exists later: ArmOrNone { pairs(edge, 1, later) } then 1
    else 2
  def laterArmOfPath(edge: Edge, first: ArmOrNone) =
    if pairs(edge, first, 0) then 0 else if pairs(edge, first, 1) then 1 else 2
  def pathLength(first: ArmOrNone, later: ArmOrNone) =
    (if first != 2 then 1 else 0) + (if later != 2 then 1 else 0)

  // --- ASSUME-2: every check can pass ---------------------------------------------

  def pointerMayBeNil(operand: PointerOperand) = operand == Nil or operand == Outside
  def pointerMayBeNonNil(operand: PointerOperand) = operand == NonNilLiteral or operand == Outside
  def loopPointerMay(nilSide: Bool) =
    (if nilSide then pointerMayBeNil(entryPointer) else pointerMayBeNonNil(entryPointer))
    or (exists arm: Arm {
      if nilSide then pointerMayBeNil(armPointer[arm]) else pointerMayBeNonNil(armPointer[arm])
    })
  def checkCanPass(edge: Edge) =
    (joinCheck[edge] == IsNil => (
      if joinPointer[edge] == PointerFromLoop then loopPointerMay(true)
      else pointerMayBeNil(joinPointer[edge])))
    and (joinCheck[edge] == NotNil => (
      if joinPointer[edge] == PointerFromLoop then loopPointerMay(false)
      else pointerMayBeNonNil(joinPointer[edge])))
  def everyCheckCanPass() = forall edge: Edge { checkCanPass(edge) }

  init {
    phase = Ready
    entryPointer = pickEntryPointer(0)
    entrySecond = pickEntrySecond(2)
    forall arm: Arm {
      armPointer[arm] = pickArmPointer(4 + 4 * arm)
      armSecond[arm] = pickArmSecond(6 + 4 * arm)
    }
    forall edge: Edge {
      joinPointer[edge] = pickJoinPointer(12 + 6 * edge)
      joinSecond[edge] = pickJoinSecond(14 + 6 * edge)
      joinCheck[edge] = pickCheck(16 + 6 * edge)
    }
    // The verdict and the witness read only the program set above.
    verdict = reported()
    witnessEdge = firstEdge()
    witnessFirstArm = firstArmOfPath(firstEdge())
    witnessLaterArm = laterArmOfPath(firstEdge(), firstArmOfPath(firstEdge()))
    witnessOutsideNil = joinCheck[firstEdge()] == IsNil
    loopPointer = NonNil
    loopSecond = GoodValue
    pointerArm = 2
    secondArm = 2
    pointerStoredLater = false
    lastArm = 2
    rounds = 0
    takenEdge = 0
    returnedPointer = NonNil
    returnedSecond = GoodValue
    onWitness = false
  }

  // --- the run --------------------------------------------------------------------

  def pointerValue(operand: PointerOperand, outsideIsNil: Bool, old: Value) =
    if operand == Nil then NilConstant
    else if operand == NonNilLiteral then NonNil
    else if operand == Outside then (if outsideIsNil then NilOutside else NonNil)
    else old
  def secondValue(operand: SecondOperand, outsideIsBad: Bool, old: SecondValue) =
    if operand == Bad then BadConstant
    else if operand == Good then GoodValue
    else if operand == SecondOutside then (if outsideIsBad then BadOutside else GoodValue)
    else old
  def passesCheck(check: Check, value: Value) =
    if check == IsNil then value != NonNil else if check == NotNil then value == NonNil else true
  def afterCheck(check: Check, value: Value) =
    if check == IsNil and value == NilOutside then NilChecked else value
  def reportableNil(value: Value) = value == NilConstant or value == NilChecked

  action enter(outsideNil: Bool, outsideBad: Bool) {
    requires phase == Ready
    requires everyCheckCanPass()
    phase = InLoop
    loopPointer = pointerValue(entryPointer, outsideNil, NonNil)
    loopSecond = secondValue(entrySecond, outsideBad, GoodValue)
    onWitness = verdict and outsideNil == witnessOutsideNil and not outsideBad
  }

  action round(arm: Arm, outsideNil: Bool, outsideBad: Bool) {
    requires phase == InLoop
    loopPointer = pointerValue(armPointer[arm], outsideNil, loopPointer)
    loopSecond = secondValue(armSecond[arm], outsideBad, loopSecond)
    pointerArm = if armPointer[arm] != KeepsPointer then arm else pointerArm
    secondArm = if armSecond[arm] != KeepsSecond then arm else secondArm
    pointerStoredLater = if armPointer[arm] != KeepsPointer and armSecond[arm] == KeepsSecond then true
                         else if armSecond[arm] != KeepsSecond then false
                         else pointerStoredLater
    lastArm = arm
    rounds = min(rounds + 1, 2)
    onWitness = onWitness
                and rounds < pathLength(witnessFirstArm, witnessLaterArm)
                and (if rounds == 0 then arm == witnessFirstArm else arm == witnessLaterArm)
                and outsideNil == witnessOutsideNil
                and not outsideBad
  }

  action leave() {
    requires phase == InLoop
    phase = AtJoin
    onWitness = onWitness and rounds == pathLength(witnessFirstArm, witnessLaterArm)
  }

  def pointerAtJoin(edge: Edge, outsideNil: Bool) =
    if joinPointer[edge] == PointerFromLoop then loopPointer
    else pointerValue(joinPointer[edge], outsideNil, NonNil)
  def secondAtJoin(edge: Edge, outsideBad: Bool) =
    if joinSecond[edge] == SecondFromLoop then loopSecond
    else secondValue(joinSecond[edge], outsideBad, GoodValue)

  action take(edge: Edge, outsideNil: Bool, outsideBad: Bool) {
    requires phase == AtJoin
    requires passesCheck(joinCheck[edge], pointerAtJoin(edge, outsideNil))
    phase = Returned
    takenEdge = edge
    returnedPointer = afterCheck(joinCheck[edge], pointerAtJoin(edge, outsideNil))
    returnedSecond = secondAtJoin(edge, outsideBad)
    onWitness = onWitness
                and edge == witnessEdge
                and outsideNil == witnessOutsideNil
                and not outsideBad
  }

  action abort() {
    requires phase == AtJoin
    phase = Aborted
    onWitness = false
  }

  terminal {
    phase == Returned
    or phase == Aborted
    or (phase == Ready and not everyCheckCanPass())
  }

  // --- what is proved -------------------------------------------------------------

  // Never blocked: the witness's edge passes its check, and the witness
  // returns the pair.
  invariant ReportMeansNilWithBad {
    (onWitness and phase == AtJoin =>
      passesCheck(joinCheck[witnessEdge], pointerAtJoin(witnessEdge, witnessOutsideNil)))
    and (onWitness and phase == Returned =>
      (reportableNil(returnedPointer) and returnedSecond == BadConstant))
  }
  invariant NilWithBadIsReported {
    (phase == Returned and reportableNil(returnedPointer) and returnedSecond == BadConstant)
    => reported()
  }

  // --- auxiliary ------------------------------------------------------------------

  def heldPointerStore() = if pointerArm == 2 then entryPointer else armPointer[pointerArm]
  def heldSecondStore() = if secondArm == 2 then entrySecond else armSecond[secondArm]
  // The path of at most two rounds that leaves what the run holds.
  def heldFirstArm() =
    if pointerArm == 2 and secondArm == 2 then lastArm
    else if pointerArm == 2 then secondArm
    else if secondArm == 2 or pointerArm == secondArm then pointerArm
    else (if pointerStoredLater then secondArm else pointerArm)
  def heldLaterArm() =
    if pointerArm == 2 or secondArm == 2 or pointerArm == secondArm then 2
    else (if pointerStoredLater then pointerArm else secondArm)
  def pointerValueFits(operand: PointerOperand, value: Value) =
    (value == NilConstant => operand == Nil)
    and (value == NilOutside => operand == Outside)
    and (value == NonNil => (operand == NonNilLiteral or operand == Outside))
    and value != NilChecked
  def secondValueFits(operand: SecondOperand, value: SecondValue) =
    (value == BadConstant => operand == Bad)
    and (value == BadOutside => operand == SecondOutside)
    and (value == GoodValue => (operand == Good or operand == SecondOutside))

  invariant ProgramShape {
    entryPointer != KeepsPointer
    and entryPointer != PointerFromLoop
    and entrySecond != KeepsSecond
    and entrySecond != SecondFromLoop
    and (forall arm: Arm { armPointer[arm] != PointerFromLoop and armSecond[arm] != SecondFromLoop })
    and (forall edge: Edge { joinPointer[edge] != KeepsPointer and joinSecond[edge] != KeepsSecond })
    and (phase != Ready => everyCheckCanPass())
  }
  invariant VerdictFixed {
    verdict == reported()
    and witnessEdge == firstEdge()
    and witnessFirstArm == firstArmOfPath(firstEdge())
    and witnessLaterArm == laterArmOfPath(firstEdge(), firstArmOfPath(firstEdge()))
    and witnessOutsideNil == (joinCheck[firstEdge()] == IsNil)
  }
  invariant FreshBeforeRun {
    phase == Ready => (
      pointerArm == 2
      and secondArm == 2
      and lastArm == 2
      and rounds == 0
      and not onWitness
    )
  }
  invariant FollowOnlyWhenReported { onWitness => verdict }
  invariant WitnessPath {
    verdict => (
      isPath(witnessFirstArm, witnessLaterArm)
      and pairs(witnessEdge, witnessFirstArm, witnessLaterArm)
    )
  }
  invariant RunValues {
    phase != Ready => (
      pointerValueFits(heldPointerStore(), loopPointer)
      and secondValueFits(heldSecondStore(), loopSecond)
    )
  }
  invariant WitnessValues {
    (onWitness and phase != Ready) => (
      (heldPointerStore() == Outside =>
        loopPointer == (if witnessOutsideNil then NilOutside else NonNil))
      and (heldSecondStore() == SecondOutside => loopSecond == GoodValue)
    )
  }
  invariant Realizable {
    phase != Ready => (
      heldPointerStore() == lastPointer(heldFirstArm(), heldLaterArm())
      and heldSecondStore() == lastSecond(heldFirstArm(), heldLaterArm())
      and isPath(heldFirstArm(), heldLaterArm())
    )
  }
  invariant SourcesStore {
    (pointerArm != 2 => armPointer[pointerArm] != KeepsPointer)
    and (secondArm != 2 => armSecond[secondArm] != KeepsSecond)
    and ((pointerArm == 2 and secondArm != 2) => armPointer[secondArm] == KeepsPointer)
    and ((secondArm == 2 and pointerArm != 2) => armSecond[pointerArm] == KeepsSecond)
    and ((pointerArm != 2 and secondArm != 2 and pointerArm != secondArm) =>
          (if pointerStoredLater then armSecond[pointerArm] == KeepsSecond
           else armPointer[secondArm] == KeepsPointer))
    and ((rounds >= 1) => lastArm != 2)
    and (rounds == 0 => (lastArm == 2 and pointerArm == 2 and secondArm == 2))
    and ((pointerArm == 2 and secondArm == 2 and lastArm != 2) =>
          (armPointer[lastArm] == KeepsPointer and armSecond[lastArm] == KeepsSecond))
  }
  invariant WitnessInOrder {
    (onWitness and phase != Ready) => (
      rounds <= pathLength(witnessFirstArm, witnessLaterArm)
      and (rounds == 0 => (
        heldPointerStore() == entryPointer
        and heldSecondStore() == entrySecond))
      and (rounds == 1 => (
        heldPointerStore() == lastPointer(witnessFirstArm, 2)
        and heldSecondStore() == lastSecond(witnessFirstArm, 2)))
      and (rounds == 2 => (
        heldPointerStore() == lastPointer(witnessFirstArm, witnessLaterArm)
        and heldSecondStore() == lastSecond(witnessFirstArm, witnessLaterArm)))
      and (phase != InLoop => rounds == pathLength(witnessFirstArm, witnessLaterArm))
    )
  }
  invariant ReturnedTraced {
    phase == Returned => (
      (joinPointer[takenEdge] == PointerFromLoop => (
        (returnedPointer == loopPointer
          or (returnedPointer == NilChecked
              and loopPointer == NilOutside
              and joinCheck[takenEdge] == IsNil))
        and passesCheck(joinCheck[takenEdge], loopPointer)))
      and (joinSecond[takenEdge] == SecondFromLoop => returnedSecond == loopSecond)
      and (joinPointer[takenEdge] != PointerFromLoop => (
        (returnedPointer == NilConstant => joinPointer[takenEdge] == Nil)
        and (returnedPointer == NilChecked =>
              (joinCheck[takenEdge] == IsNil and joinPointer[takenEdge] == Outside))))
      and (joinSecond[takenEdge] != SecondFromLoop =>
            (returnedSecond == BadConstant => joinSecond[takenEdge] == Bad))
      and (joinCheck[takenEdge] == NotNil => returnedPointer == NonNil)
      and (returnedPointer == NilChecked => joinCheck[takenEdge] == IsNil)
    )
  }

  // --- witnesses ------------------------------------------------------------------

  def bothFromLoop(edge: Edge) =
    joinPointer[edge] == PointerFromLoop and joinSecond[edge] == SecondFromLoop

  // `var u *T; var err error; if b { u = x } else { err = e }; return u,
  // err`. That is one round of the loop, then the edge that brings both
  // from H.
  reachable EdgesKeptApart {
    phase == Returned
    and not reported()
    and entryPointer == Nil
    and entrySecond == Bad
    and armPointer[0] == NonNilLiteral
    and armSecond[0] == KeepsSecond
    and armPointer[1] == KeepsPointer
    and armSecond[1] == Good
    and bothFromLoop(takenEdge)
    and rounds == 1
  }
  // A nil set in one round and a nil error in the next: reported.
  reachable PairAcrossRounds {
    phase == Returned
    and onWitness
    and pathLength(witnessFirstArm, witnessLaterArm) == 2
    and bothFromLoop(witnessEdge)
    and not pairs(witnessEdge, witnessFirstArm, 2)
    and not pairs(witnessEdge, witnessLaterArm, 2)
  }
  // if u != nil { return u, s }: the check settles u before H is taken apart.
  reachable CheckStopsThePair {
    phase == Returned
    and not reported()
    and joinCheck[takenEdge] == NotNil
    and bothFromLoop(takenEdge)
    and (exists first: ArmOrNone { exists later: ArmOrNone {
      isPath(first, later) and lastPointer(first, later) == Nil and lastSecond(first, later) == Bad
    } })
  }
  // `u := f(); if u == nil { return u, nil }`: a value from before J,
  // checked on the edge.
  reachable CheckedOutsideWithBad {
    phase == Returned
    and onWitness
    and joinCheck[witnessEdge] == IsNil
    and joinPointer[witnessEdge] == Outside
    and returnedPointer == NilChecked
  }
  reachable CheckedLoopValueWithBad {
    phase == Returned
    and onWitness
    and joinCheck[witnessEdge] == IsNil
    and joinPointer[witnessEdge] == PointerFromLoop
    and returnedPointer == NilChecked
  }
  // return nil, err with err from outside: not reported. This is the gap.
  reachable OutsideErrorNotReported {
    phase == Returned
    and not reported()
    and returnedPointer == NilConstant
    and returnedSecond == BadOutside
  }
  // return u, nil with u from outside and unchecked: not reported. This is
  // the gap.
  reachable OutsideNilNotReported {
    phase == Returned
    and not reported()
    and returnedPointer == NilOutside
    and returnedSecond == BadConstant
  }
}
