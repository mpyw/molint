// What a "nil value" report means, for a value built from φ-nodes and nil
// checks. return-nil, wrap-nil and unwrap-nil all rest on it. See "Nil values"
// in design/rules.md.
//
// The program has a loop and a join. The loop carries two φ-nodes, a and b.
// The join carries the returned φ-node, r, with three edges:
//
//   a, b := A0, B0                 entry operands: nil, &T{}, or f()
//   for cond() {
//     a, b = A1, B1                back-edge operands: nil, &T{}, f(), a or b
//   }
//   switch {                       three edges into the join; each edge may sit
//   case c0: r = R0                under a check of its own operand, as in
//   case c1: r = R1                  if R0 == nil { r = R0 }   (IsNil)
//   default: r = R2                  if R0 != nil { r = R0 }   (NotNil)
//   }
//   return r
//
// f() stands for any value from outside: a parameter, a field, a call's
// result. Each evaluation may give nil or not. `if p == nil { p = def }; return
// p` is this shape with R0 = p under NotNil and R1 = def.
//
// The rule, nilOp below, reads only the program: its operands and its checks.
// The constant nil is a nil value. A φ-node is one when an edge brings one.
// An edge under NotNil brings none. An edge under IsNil brings one, whatever
// its operand. A value from outside is not one.
//
// The claim. The rule reports r exactly when some run of this program returns
// a nil that is a constant's, or that passed a nil check. In detail:
//
//   ReportMeansANilIsReturned  when r is reported, the witness run below
//                              is never blocked and returns such a nil.
//                              So some run returns it.
//   ConstantNilIsReported      whenever a run returns a nil constant, r is
//                              reported. A nil check on the way is judged
//                              at its own edge, so it cannot hide one.
//
// A nil from outside that no check tests is not reported. That is the scope
// the rules give to nilaway. ExtNilIsNotReported witnesses it.
//
// The witness run is built from the rule's verdict alone. It takes the first
// edge of the join that brings a nil. It makes every f() nil when that edge
// is under IsNil, and non-nil otherwise. It goes round the loop just as often
// as the nil needs to reach the φ-node: a nil can take two rounds, as in
// `a, b = b, nil`.
//
// ASSUME-1: branch conditions other than nil checks of the value itself are
//   independent, so the run may take any edge. The rule does not read them.
//   nil_value_correlated.fsl shows the false report when two branches test the
//   same condition.
// ASSUME-2: a nil check under IsNil tests a value that some run makes nil.
//   `p := &T{}; if p == nil { return p }` is dead code, and the rule reports
//   it. nil_value_dead_check.fsl holds that case.
// ASSUME-3 (representation only): two loop φ-nodes, three join edges, one
//   check per edge. Two φ-nodes are enough for a nil to need two rounds.
// ASSUME-4 (representation only): a value is tracked only as nil from a
//   constant, nil from outside, or non-nil. Which non-nil value does not
//   matter to the rule.
// ASSUME-5: ChangeType is not modeled. The rule and the run both see through
//   it, so it adds nothing to check.
spec NilValue {
  enum Op { Nil, Alloc, Ext, PhiA, PhiB }
  enum Guard { NoCheck, IsNil, NotNil }
  enum Val { NilConst, NilExt, NonNil }
  enum Pc { Config, Ready, Judged, Loop, Join, Returned, Aborted }
  type Edge = 0..2
  type Iter = 0..3

  state {
    pc: Pc,
    a0: Op, b0: Op, a1: Op, b1: Op,
    r: Map<Edge, Op>, g: Map<Edge, Guard>,
    // the run
    a: Val, b: Val, iters: Iter, rv: Val, taken: Edge,
    // the rule's verdict and its witness, fixed with the program
    rep: Bool, w: Edge, wnil: Bool, wrounds: Iter,
    // the run has made the witness's choices so far
    follow: Bool
  }

  init {
    pc = Config
    a0 = Alloc  b0 = Alloc  a1 = Alloc  b1 = Alloc
    forall k: Edge { r[k] = Alloc  g[k] = NoCheck }
    a = NonNil  b = NonNil  iters = 0  rv = NonNil  taken = 0
    rep = false  w = 0  wnil = false  wrounds = 0
    follow = false
  }

  // --- the rule: a pure function of the program ---------------------------------

  def src(o: Op) = o == Nil
  def nilA() = src(a0) or src(a1) or (a1 == PhiB and (src(b0) or src(b1)))
  def nilB() = src(b0) or src(b1) or (b1 == PhiA and (src(a0) or src(a1)))
  def nilOp(o: Op) = src(o) or (o == PhiA and nilA()) or (o == PhiB and nilB())
  def brings(k: Edge) = g[k] == IsNil or (g[k] == NoCheck and nilOp(r[k]))
  def reported() = exists k: Edge { brings(k) }

  // --- what may be nil at run time, counting values from outside ----------------

  def may(o: Op) = o == Nil or o == Ext
  def mayA() = may(a0) or may(a1) or (a1 == PhiB and (may(b0) or may(b1)))
  def mayB() = may(b0) or may(b1) or (b1 == PhiA and (may(a0) or may(a1)))
  def mayOp(o: Op) = may(o) or (o == PhiA and mayA()) or (o == PhiB and mayB())

  // --- the program ----------------------------------------------------------------

  // The program is fixed a block at a time, in any order, before the run.
  action setEntry(ea: Op, eb: Op) {
    requires pc == Config
    requires ea == Nil or ea == Alloc or ea == Ext
    requires eb == Nil or eb == Alloc or eb == Ext
    a0 = ea  b0 = eb
  }
  action setBackEdge(la: Op, lb: Op) {
    requires pc == Config
    a1 = la  b1 = lb
  }
  action setEdge(k: Edge, o: Op, c: Guard) {
    requires pc == Config
    r[k] = o  g[k] = c
  }
  action start() {
    requires pc == Config
    pc = Ready
  }

  // ASSUME-2: no check under IsNil is dead.
  def configOk() =
    (a0 == Nil or a0 == Alloc or a0 == Ext) and (b0 == Nil or b0 == Alloc or b0 == Ext)
    and (forall k: Edge { g[k] == IsNil => mayOp(r[k]) })

  // --- the witness run, chosen from the rule's verdict ----------------------------

  def wk() = if brings(0) then 0 else if brings(1) then 1 else 2
  def wx() = g[wk()] == IsNil
  // A source of a nil under the witness's choice for f().
  def ws(o: Op) = if wx() then may(o) else src(o)
  def roundsA() =
    if ws(a0) then 0 else if ws(a1) then 1
    else if a1 == PhiB and ws(b0) then 1 else 2
  def roundsB() =
    if ws(b0) then 0 else if ws(b1) then 1
    else if b1 == PhiA and ws(a0) then 1 else 2
  def rounds() =
    if r[wk()] == PhiA then roundsA() else if r[wk()] == PhiB then roundsB() else 0

  // --- the run --------------------------------------------------------------------

  // What an operand evaluates to. nilOut is the value f() gives this time.
  def ev(o: Op, nilOut: Bool) =
    if o == Nil then NilConst
    else if o == Alloc then NonNil
    else if o == Ext then (if nilOut then NilExt else NonNil)
    else if o == PhiA then a
    else b
  def passes(c: Guard, v: Val) =
    if c == IsNil then v != NonNil else if c == NotNil then v == NonNil else true

  // Fixes the verdict and the witness. They read only the program, which
  // configure has just set.
  action judge() {
    requires pc == Ready  requires configOk()
    pc = Judged
    rep = reported()  w = wk()  wnil = wx()  wrounds = rounds()
  }

  action enter(na: Bool, nb: Bool) {
    requires pc == Judged
    pc = Loop
    a = ev(a0, na)  b = ev(b0, nb)
    follow = rep and na == wnil and nb == wnil
  }

  action round(na: Bool, nb: Bool) {
    requires pc == Loop
    a = ev(a1, na)  b = ev(b1, nb)
    iters = min(iters + 1, 3)
    follow = follow and iters < wrounds and na == wnil and nb == wnil
  }

  action exit() {
    requires pc == Loop
    pc = Join
    follow = follow and iters == wrounds
  }

  action take(k: Edge, n: Bool) {
    requires pc == Join  requires passes(g[k], ev(r[k], n))
    pc = Returned  taken = k
    rv = ev(r[k], n)
    follow = follow and k == w and n == wnil
  }

  // No edge may pass its check. The function then panics or never returns.
  action abort() {
    requires pc == Join
    pc = Aborted  follow = false
  }

  terminal { pc == Returned or pc == Aborted }

  // --- what is proved -------------------------------------------------------------

  // What the witness needs of a value: nil, and from a constant unless the
  // witness's edge checks it.
  def witnessNil(v: Val) = if wnil then v != NonNil else v == NilConst

  invariant ReportMeansANilIsReturned {
    (follow and pc == Join => passes(g[w], ev(r[w], wnil)))
    and (follow and pc == Returned => witnessNil(rv))
  }

  invariant ConstantNilIsReported { (pc == Returned and rv == NilConst) => reported() }

  // --- auxiliary: what makes the two inductive ------------------------------------

  invariant ProgramFixed { pc != Config => configOk() }
  invariant VerdictFixed {
    (pc != Config and pc != Ready) =>
      (rep == reported() and w == wk() and wnil == wx() and wrounds == rounds())
  }
  invariant FreshBeforeRun {
    (pc == Config or pc == Ready or pc == Judged) =>
      (a == NonNil and b == NonNil and iters == 0 and not follow)
  }
  invariant FollowOnlyWhenReported { follow => rep }
  invariant NilConstTraced { (a == NilConst => nilA()) and (b == NilConst => nilB()) }
  invariant ReturnedTaken { pc == Returned => rv == ev(r[taken], rv == NilExt) }
  invariant FollowWithinRounds {
    (follow and pc == Loop => iters <= wrounds) and (follow and pc == Join => iters == wrounds)
  }
  // Under the witness's choices, where the loop φ-nodes hold a nil.
  invariant WitnessEntry {
    (follow and (pc == Loop or pc == Join) and iters == 0) =>
      ((ws(a0) => witnessNil(a)) and (ws(b0) => witnessNil(b)))
  }
  invariant WitnessBackEdge {
    (follow and (pc == Loop or pc == Join) and iters >= 1) =>
      ((ws(a1) => witnessNil(a)) and (ws(b1) => witnessNil(b)))
  }
  invariant WitnessRoundOne {
    (follow and (pc == Loop or pc == Join) and iters == 1) =>
      ((a1 == PhiB and ws(b0) => witnessNil(a)) and (b1 == PhiA and ws(a0) => witnessNil(b)))
  }
  invariant WitnessRoundTwo {
    (follow and (pc == Loop or pc == Join) and iters == 2) =>
      ((a1 == PhiB and ws(b1) => witnessNil(a)) and (b1 == PhiA and ws(a1) => witnessNil(b)))
  }

  // --- witnesses ------------------------------------------------------------------

  // a, b = b, nil: the nil reaches a on the second round.
  reachable NilAfterTwoRounds {
    pc == Returned and rv == NilConst and r[taken] == PhiA and a1 == PhiB and b1 == Nil
    and a0 == Alloc and b0 == Alloc and iters == 2
  }
  // if p == nil { p = def }; return p, where p may be nil.
  reachable CheckStopsTheNil {
    pc == Returned and not reported() and nilA() and r[0] == PhiA and g[0] == NotNil
    and r[1] == Alloc and g[1] == NoCheck and r[2] == Alloc
  }
  reachable CheckedOutsideNilReported {
    pc == Returned and reported() and r[taken] == Ext and g[taken] == IsNil and rv == NilExt
  }
  reachable CheckedPhiNilReported {
    pc == Returned and reported() and r[taken] == PhiB and g[taken] == IsNil
    and not nilB() and rv == NilExt
  }
  reachable ExtNilIsNotReported { pc == Returned and rv == NilExt and not reported() }
  // A report says some run returns nil, not this one.
  reachable ReportedRunReturnsNonNil { pc == Returned and reported() and rv == NonNil }
}
